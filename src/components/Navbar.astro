---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const whatsappNumber = "59172227461";
const baseWhatsappLink = `https://api.whatsapp.com/send?phone=${whatsappNumber}`;
---

<!-- Header / Navigation Component -->
<header class="fixed w-full bg-white/95 backdrop-blur-lg z-50 border-b border-brand-light transition-all duration-300 top-0 left-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20 md:h-24">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 md:gap-4 group">
        <div class="w-14 h-14 md:w-20 md:h-20 rounded-full bg-white border border-brand-gold flex flex-col items-center justify-center shadow-sm relative overflow-hidden px-1 md:px-2 shrink-0 group-hover:scale-102 transition-transform">
          <span class="font-cursive text-brand-dark text-lg md:text-2xl leading-none pt-1 md:pt-2">Montalvo</span>
          <div class="w-10 md:w-14 h-[1px] bg-gradient-to-r from-transparent via-brand-gold to-transparent my-0.5 md:my-1"></div>
          <span class="font-sans text-[5px] md:text-[7px] tracking-[0.25em] text-brand-dark font-extrabold leading-none uppercase">Catering</span>
        </div>
        <div class="flex flex-col">
          <span class="font-serif font-extrabold text-lg md:text-2xl text-brand-dark tracking-tight leading-none">Montalvo</span>
          <span class="font-sans text-[8px] md:text-[11px] tracking-[0.3em] text-brand-gold font-bold uppercase mt-0.5 md:mt-1">Catering</span>
        </div>
      </a>
      
      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8 text-xs font-bold uppercase tracking-wider text-gray-600">
        <a href="/#hero" class="hover:text-brand-gold transition-colors">Inicio</a>
        <a href="/#nosotros" class="hover:text-brand-gold transition-colors">Nosotros</a>
        <a href="/#nuestros-bowls" class="hover:text-brand-gold transition-colors">Bowls</a>
        <a href="/#carbs" class="hover:text-brand-gold transition-colors">Carbohidratos</a>
        <a href="/#planes" class="hover:text-brand-gold transition-colors">Planes</a>
        <a href="/armar-plan" class={`hover:text-brand-gold transition-colors ${currentPath === '/armar-plan' ? 'text-brand-gold font-extrabold' : ''}`}>Armar Plan</a>
        <a href="/#equipo" class="hover:text-brand-gold transition-colors">Equipo</a>
      </nav>

      <!-- CTA & Mobile Menu Toggle -->
      <div class="flex items-center gap-3 md:gap-4">
        <a 
          href="/armar-plan" 
          class="bg-brand-gold hover:bg-brand-gold-dark text-white px-5 py-2.5 md:px-7 md:py-3 rounded-full font-bold text-[10px] md:text-xs uppercase tracking-wider transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5 whitespace-nowrap flex items-center gap-1.5"
        >
          <span>Pedir</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        
        <!-- Hamburger Button -->
        <button id="nav-mobile-menu-btn" class="lg:hidden text-brand-dark p-2 focus:outline-none cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Mobile Menu Overlay -->
  <div id="nav-mobile-menu" class="hidden lg:hidden bg-white border-t border-brand-light">
    <nav class="flex flex-col items-center py-4 space-y-4 text-sm font-bold uppercase tracking-wider text-gray-600 shadow-lg">
      <a href="/#hero" class="nav-mobile-link hover:text-brand-gold transition-colors">Inicio</a>
      <a href="/#nosotros" class="nav-mobile-link hover:text-brand-gold transition-colors">Nosotros</a>
      <a href="/#nuestros-bowls" class="nav-mobile-link hover:text-brand-gold transition-colors">Bowls</a>
      <a href="/#carbs" class="nav-mobile-link hover:text-brand-gold transition-colors">Carbohidratos</a>
      <a href="/#planes" class="nav-mobile-link hover:text-brand-gold transition-colors">Planes</a>
      <a href="/armar-plan" class="nav-mobile-link text-brand-gold font-extrabold transition-colors">Armar Plan</a>
      <a href="/#equipo" class="nav-mobile-link hover:text-brand-gold transition-colors">Equipo</a>
    </nav>
  </div>
</header>

<script is:inline>
  const navMobileBtn = document.getElementById('nav-mobile-menu-btn');
  const navMobileMenu = document.getElementById('nav-mobile-menu');
  
  if (navMobileBtn && navMobileMenu) {
    navMobileBtn.addEventListener('click', () => {
      navMobileMenu.classList.toggle('hidden');
    });

    document.querySelectorAll('.nav-mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        navMobileMenu.classList.add('hidden');
      });
    });
  }
</script>
