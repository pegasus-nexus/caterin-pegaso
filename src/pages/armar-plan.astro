---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const whatsappNumber = "59172227461";
const baseWhatsappLink = `https://api.whatsapp.com/send?phone=${whatsappNumber}`;

// Configuración de los Bowls disponibles
const availableBowls = [
  {
    id: "salteado",
    name: "Bowl Salteado",
    tagline: "Wok caliente y reconfortante",
    icon: `<svg class="w-5 h-5 text-[#B8935B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" /></svg>`,
    carb: "Quinua con sofrito de cebolla y pimentón",
    veg: "Cebolla, pimentón, calabacín y zanahoria salteados al wok"
  },
  {
    id: "fresco",
    name: "Bowl Fresco",
    tagline: "Fresco, ligero y crujiente",
    icon: `<svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    carb: "Carbohidrato del día (según menú semanal)",
    veg: "Lechuga, zanahoria, tomate, apio y pepino con hierbabuena"
  }
];

// Opciones de proteína
const availableProteins = [
  { id: "Pollo a la Plancha", name: "Pollo a la Plancha", desc: "Pechuga magra marinada con finas hierbas" },
  { id: "Albóndigas de Carne (Air Fryer)", name: "Albóndigas de Carne (Air Fryer)", desc: "Preparadas al aire caliente sin exceso de grasas" },
  { id: "Huevos Hervidos", name: "Huevos Hervidos", desc: "2 unidades en punto exacto de cocción" }
];
---

<Layout title="Arma tu Plan & Personaliza tus Bowls | Montalvo Catering">
  <!-- Reusable Global Navbar -->
  <Navbar currentPath="/armar-plan" />

  <div class="min-h-screen bg-[#FDFBF7] text-[#1e1912] pt-24 md:pt-28 pb-20 selection:bg-brand-gold-light selection:text-brand-dark">
    
    <!-- Main Form Container -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      
      <!-- Top Card Wrapper -->
      <div class="bg-white rounded-3xl sm:rounded-[32px] border border-gray-200/80 shadow-xl overflow-hidden">
        
        <!-- Header: Ficha & Pedido -->
        <div class="px-6 sm:px-10 pt-8 pb-4 border-b border-gray-100 flex items-start justify-between">
          <div>
            <span class="block text-xs font-extrabold uppercase tracking-widest text-[#8A6F56] mb-1">
              Ficha & Pedido Personalizado
            </span>
            <h1 class="font-serif font-black text-2xl sm:text-3xl lg:text-4xl text-gray-900 tracking-tight" id="main-plan-title">
              Arma tus Bowls · Plan Semanal
            </h1>
            <p class="text-xs sm:text-sm text-gray-500 font-medium mt-1" id="main-plan-subtitle">
              Elige tu plan, tamaño, modalidad y personaliza cada comida
            </p>
          </div>

          <a 
            href="/" 
            class="text-gray-400 hover:text-gray-700 p-2 rounded-full hover:bg-gray-100 transition-colors"
            title="Volver al inicio"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </a>
        </div>

        <!-- Navigation Tabs: Personalizar / Nutrición -->
        <div class="px-6 sm:px-10 flex border-b border-gray-200 text-xs sm:text-sm font-bold uppercase tracking-wider">
          <button 
            type="button" 
            id="tab-btn-personalizar" 
            class="py-4 px-4 sm:px-6 text-[#8A6F56] border-b-2 border-[#B8935B] flex items-center gap-2 cursor-pointer transition-colors"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            <span>Personalizar</span>
          </button>

          <button 
            type="button" 
            id="tab-btn-nutricion" 
            class="py-4 px-4 sm:px-6 text-gray-400 hover:text-gray-600 border-b-2 border-transparent flex items-center gap-2 cursor-pointer transition-colors"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Nutrición</span>
          </button>
        </div>

        <!-- PLAN CONFIGURATOR BAR (Tamaño / Frecuencia / Modalidad) -->
        <div class="px-6 sm:px-10 py-6 bg-[#FAF6F0] border-b border-brand-gold/15 space-y-5">
          <span class="block text-xs font-black uppercase tracking-wider text-[#8A6F56]">
            Configuración de tu Plan:
          </span>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
            
            <!-- 1. TAMAÑO DEL BOWL (Mediano / Grande) -->
            <div class="space-y-2">
              <label class="block text-[11px] font-bold uppercase tracking-wider text-gray-700">
                1. Tamaño del Bowl
              </label>
              <div class="grid grid-cols-2 gap-2 bg-white p-1 rounded-2xl border border-gray-200 shadow-2xs">
                <button
                  type="button"
                  class="size-selector-btn py-2.5 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs"
                  data-size="mediano"
                >
                  Mediano <span class="block text-[10px] font-medium opacity-90">~400g</span>
                </button>
                <button
                  type="button"
                  class="size-selector-btn py-2.5 px-3 rounded-xl text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all cursor-pointer"
                  data-size="grande"
                >
                  Grande <span class="block text-[10px] font-medium opacity-70">~650g</span>
                </button>
              </div>
            </div>

            <!-- 2. FRECUENCIA / PLAN (Diario / Flexible / Semanal / Mensual) -->
            <div class="space-y-2">
              <label class="block text-[11px] font-bold uppercase tracking-wider text-gray-700">
                2. Frecuencia del Plan
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 bg-white p-1 rounded-2xl border border-gray-200 shadow-2xs">
                <button
                  type="button"
                  class="freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-semibold text-gray-600 hover:text-gray-900 text-center transition-all cursor-pointer"
                  data-freq="diario"
                >
                  Diario
                </button>
                <button
                  type="button"
                  class="freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-semibold text-gray-600 hover:text-gray-900 text-center transition-all cursor-pointer"
                  data-freq="flexible"
                >
                  Flexible
                </button>
                <button
                  type="button"
                  class="freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-extrabold text-center transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs"
                  data-freq="semanal"
                >
                  Semanal
                </button>
                <button
                  type="button"
                  class="freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-semibold text-gray-600 hover:text-gray-900 text-center transition-all cursor-pointer"
                  data-freq="mensual"
                >
                  Mensual
                </button>
              </div>
            </div>

            <!-- 3. MODALIDAD (Individual / Grupal) -->
            <div id="option-selector-wrapper" class="space-y-2 transition-all duration-300">
              <label class="block text-[11px] font-bold uppercase tracking-wider text-gray-700">
                3. Modalidad
              </label>
              <div class="grid grid-cols-2 gap-2 bg-white p-1 rounded-2xl border border-gray-200 shadow-2xs">
                <button
                  type="button"
                  class="option-selector-btn py-2.5 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs"
                  data-option="individual"
                >
                  Individual <span class="block text-[10px] font-medium opacity-90">1 persona</span>
                </button>
                <button
                  type="button"
                  class="option-selector-btn py-2.5 px-3 rounded-xl text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all cursor-pointer"
                  data-option="grupal"
                >
                  Grupal <span class="block text-[10px] font-medium opacity-70">3+ personas</span>
                </button>
              </div>
            </div>

          </div>

          <!-- DYNAMIC DELIVERY DAYS PICKER (Interactive for Diario & Flexible) -->
          <div id="delivery-days-config-box" class="p-4 sm:p-5 rounded-2xl bg-white border border-brand-gold/30 shadow-xs space-y-3 transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <span class="block text-xs font-extrabold uppercase tracking-wider text-[#8A6F56]" id="days-picker-title">
                  📅 Días de entrega para tu plan:
                </span>
                <p class="text-xs text-gray-500 font-medium" id="days-picker-subtitle">
                  Selecciona los días específicos de la semana en los que deseas recibir tus almuerzos
                </p>
              </div>
              <span id="days-count-badge" class="self-start sm:self-auto text-xs font-black px-3 py-1 rounded-full bg-[#FAF6F0] text-[#8A6F56] border border-brand-gold/30">
                3 de 3 días seleccionados
              </span>
            </div>

            <!-- Days Buttons Grid -->
            <div id="days-buttons-picker" class="grid grid-cols-5 gap-2 sm:gap-3 pt-1">
              <!-- Dynamically populated day selector buttons -->
            </div>

            <!-- Helper notice for Flexible & Diario -->
            <div id="days-helper-notice" class="text-[11px] text-gray-500 font-medium flex items-center gap-1.5 pt-1">
              <span class="text-[#B8935B] font-bold">💡</span>
              <span id="days-helper-text">Puedes cambiar los días haciendo clic sobre ellos.</span>
            </div>
          </div>

          <!-- Dynamic Plan Description Callout -->
          <div class="p-3.5 rounded-xl bg-white/90 border border-brand-gold/20 flex items-start gap-2.5 text-xs text-gray-700">
            <span class="text-brand-gold-dark font-bold text-sm leading-none mt-0.5">ℹ️</span>
            <div id="plan-description-banner" class="leading-relaxed font-medium">
              Consta de <strong>5 bowls</strong> que puede consumir durante el periodo de <strong>hasta 2 semanas</strong> para <strong>1 persona</strong>.
            </div>
          </div>
        </div>

        <!-- Customer Identification Inputs -->
        <div class="px-6 sm:px-10 py-5 bg-white border-b border-gray-100 flex flex-col sm:flex-row gap-4">
          <div class="flex-1">
            <label for="customer-name" class="block text-xs font-bold uppercase tracking-wider text-[#8A6F56] mb-1">
              Nombre del Cliente <span class="text-rose-500">*</span>
            </label>
            <input 
              type="text" 
              id="customer-name" 
              placeholder="Ingresa tu nombre y apellido" 
              class="w-full bg-[#FAF6F0]/60 border border-gray-300 focus:border-[#B8935B] focus:ring-2 focus:ring-[#B8935B]/20 rounded-xl px-4 py-2.5 text-sm text-gray-900 font-medium placeholder:text-gray-400 outline-none transition-all shadow-2xs"
              required
            />
          </div>
          <div class="flex-1">
            <label for="customer-address" class="block text-xs font-bold uppercase tracking-wider text-[#8A6F56] mb-1">
              Dirección de Entrega <span class="text-gray-400 text-[10px] font-normal">(Opcional)</span>
            </label>
            <input 
              type="text" 
              id="customer-address" 
              placeholder="Ej. Calle Gral. Achá #739, Oficina 4B" 
              class="w-full bg-[#FAF6F0]/60 border border-gray-300 focus:border-[#B8935B] focus:ring-2 focus:ring-[#B8935B]/20 rounded-xl px-4 py-2.5 text-sm text-gray-900 font-medium placeholder:text-gray-400 outline-none transition-all shadow-2xs"
            />
          </div>
        </div>

        <!-- Content Area (Grid with Form + Sidebar) -->
        <div class="p-6 sm:p-10">
          
          <!-- TAB 1: PERSONALIZADOR VIEW -->
          <div id="tab-content-personalizar" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- LEFT: Day-by-day Builder (8 cols) -->
            <div class="lg:col-span-7 xl:col-span-8 space-y-8">
              
              <!-- SECTION 1: ELIGE EL DÍA / BOWL DEL PLAN -->
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="block text-xs font-extrabold uppercase tracking-wider text-gray-700" id="step1-heading-text">
                    1. Elige el día a configurar
                  </span>
                  <span id="day-selection-badge" class="text-xs font-bold text-[#8A6F56] bg-[#FAF6F0] px-3 py-1 rounded-full border border-brand-gold/20">
                    Lunes seleccionado
                  </span>
                </div>

                <!-- Days Dynamic Tabs Selector -->
                <div id="days-selector-container" class="grid grid-cols-5 gap-2 sm:gap-3">
                  <!-- Injected dynamically by JS -->
                </div>
              </div>

              <!-- SECTION 2: ELIGE EL TIPO DE BOWL -->
              <div class="space-y-3 pt-2">
                <span class="block text-xs font-extrabold uppercase tracking-wider text-gray-700">
                  2. Elige el tipo de bowl
                </span>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                  {availableBowls.map((bowl) => (
                    <label class="bowl-option-card relative flex flex-col justify-between p-4 sm:p-5 rounded-2xl border-2 border-gray-200 hover:border-[#B8935B]/60 bg-white cursor-pointer transition-all group">
                      <input 
                        type="radio" 
                        name="selected-bowl" 
                        value={bowl.id} 
                        class="bowl-radio absolute opacity-0" 
                      />
                      
                      <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-3">
                          <div class="w-9 h-9 rounded-xl bg-[#FAF6F0] flex items-center justify-center shrink-0">
                            <Fragment set:html={bowl.icon} />
                          </div>
                          <div>
                            <span class="font-extrabold text-base text-gray-900 block">{bowl.name}</span>
                            <span class="text-xs text-gray-400 font-medium block">{bowl.tagline}</span>
                          </div>
                        </div>

                        <!-- Check Circle -->
                        <div class="bowl-check-circle w-6 h-6 rounded-full border-2 border-gray-300 group-hover:border-[#B8935B] flex items-center justify-center text-white text-xs font-bold transition-all shrink-0">
                          <span class="hidden">✓</span>
                        </div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <!-- SECTION 3: ELIGE TU PROTEÍNA -->
              <div class="space-y-3 pt-2">
                <span class="block text-xs font-extrabold uppercase tracking-wider text-gray-700">
                  3. Elige tu proteína
                </span>

                <div class="space-y-2.5">
                  {availableProteins.map((protein) => (
                    <label class="protein-option-card relative flex items-center justify-between p-4 rounded-2xl border-2 border-gray-200 hover:border-[#B8935B]/60 bg-white cursor-pointer transition-all group">
                      <input 
                        type="radio" 
                        name="selected-protein" 
                        value={protein.id} 
                        class="protein-radio absolute opacity-0" 
                      />

                      <div class="flex items-center gap-3.5">
                        <!-- Check Circle -->
                        <div class="protein-check-circle w-6 h-6 rounded-full border-2 border-gray-300 group-hover:border-[#B8935B] flex items-center justify-center text-white text-xs font-bold transition-all shrink-0">
                          <span class="hidden">✓</span>
                        </div>
                        
                        <div>
                          <span class="font-extrabold text-sm sm:text-base text-gray-900 block">{protein.name}</span>
                          <span class="text-xs text-gray-400 font-medium block">{protein.desc}</span>
                        </div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <!-- INGREDIENTES BASE INCLUIDOS BOX -->
              <div class="p-5 sm:p-6 rounded-2xl bg-[#FAF6F0] border border-brand-gold/20 space-y-3">
                <span class="block text-xs font-black uppercase tracking-wider text-[#8A6F56]">
                  Ingredientes Base Incluidos:
                </span>
                
                <div class="space-y-2 text-xs sm:text-sm text-gray-700">
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
                    <strong class="text-gray-900 shrink-0">Carbohidrato del día:</strong>
                    <span id="base-carb-desc" class="font-bold text-gray-900">Quinua con sofrito de cebolla y pimentón</span>
                  </div>
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
                    <strong class="text-gray-900 shrink-0">Ensalada / Vegetales:</strong>
                    <span id="base-veg-desc" class="text-gray-600 font-medium">Cebolla, pimentón, calabacín y zanahoria salteados al wok</span>
                  </div>
                </div>
              </div>

              <!-- Day Save and Advance Button -->
              <div class="flex justify-end pt-2">
                <button
                  type="button"
                  id="btn-save-day"
                  class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-[#B8935B] hover:bg-[#917237] text-white font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-md hover:-translate-y-0.5 active:scale-98 cursor-pointer flex items-center justify-center gap-2 shrink-0 opacity-50 pointer-events-none"
                >
                  <span id="btn-save-day-text">Guardar y siguiente</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </button>
              </div>

            </div>

            <!-- RIGHT: Sidebar Summary & Final WhatsApp CTA (4 cols) -->
            <div class="lg:col-span-5 xl:col-span-4 sticky top-28 space-y-6">
              
              <div class="bg-[#FAF6F0] p-6 rounded-3xl border border-brand-gold/25 space-y-6 shadow-xs">
                
                <!-- Summary Header -->
                <div class="flex items-center justify-between pb-4 border-b border-brand-gold/20">
                  <div>
                    <h3 class="font-serif text-xl font-bold text-gray-900">Mis elecciones</h3>
                    <span class="text-xs text-gray-500 font-medium" id="sidebar-plan-label">Plan Semanal (5 bowls)</span>
                  </div>
                  <span id="progress-counter-badge" class="text-xs font-black px-3 py-1 rounded-full bg-white text-[#8A6F56] border border-brand-gold/30 shadow-2xs">
                    0 de 5
                  </span>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-white rounded-full h-2 overflow-hidden border border-brand-gold/15">
                  <div id="progress-bar-fill" class="bg-[#B8935B] h-full rounded-full transition-all duration-500 w-0"></div>
                </div>

                <!-- Days List Summary -->
                <div class="space-y-2" id="summary-days-list">
                  <!-- Dynamically populated rows -->
                </div>

                <!-- Total a Pagar & WhatsApp CTA -->
                <div class="pt-4 border-t border-brand-gold/20 space-y-4">
                  <div>
                    <span class="block text-xs font-bold uppercase tracking-wider text-gray-400">Total a pagar:</span>
                    <span id="sidebar-price-display" class="font-black text-3xl sm:text-4xl text-gray-950 block mt-0.5">Bs. 110</span>
                    <span id="sidebar-size-desc" class="text-[11px] text-gray-500 font-medium">Tamaño Mediano (~400g)</span>
                  </div>

                  <a 
                    id="btn-confirm-whatsapp"
                    href="#"
                    target="_blank"
                    class="w-full bg-[#B8935B] hover:bg-[#917237] text-white text-center py-4 rounded-2xl font-extrabold uppercase tracking-wider text-xs transition-all duration-300 shadow-md flex items-center justify-center gap-2 opacity-50 pointer-events-none cursor-not-allowed"
                  >
                    <span>Pedir por WhatsApp</span>
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm5.79-3.554c1.666.988 3.536 1.509 5.44 1.51h.005c5.772 0 10.468-4.697 10.472-10.47 0-2.796-1.09-5.429-3.07-7.41-1.98-1.981-4.61-3.068-7.405-3.069C6.262 1.01 1.566 5.706 1.561 11.479c0 1.995.525 3.943 1.523 5.656l-.982 3.585 3.675-.964zm11.758-5.326c-.302-.15-.178-.225.405-1.026.482-.663.602-.753.844-1.115.195-.29.098-.56-.05-.71-.148-.15-1.48-3.567-1.88-4.526-.226-.543-.45-.47-.622-.48l-.532-.012c-.185 0-.485.07-.74.352-.254.282-.97.948-.97 2.31 0 1.363.99 2.68 1.13 2.868.138.188 1.95 2.977 4.727 4.174.66.285 1.176.455 1.578.583.663.21 1.267.18 1.744.11.53-.08 1.63-.667 1.86-1.282.23-.615.23-1.143.16-1.253-.07-.11-.253-.185-.555-.335z"/></svg>
                  </a>

                  <p id="validation-help-text" class="text-[11px] text-center text-gray-500 font-medium">
                    Completa todos los bowls y tu nombre para continuar.
                  </p>
                </div>

              </div>

              <!-- Reset Button -->
              <div class="text-center">
                <button 
                  type="button" 
                  id="btn-reset-plan"
                  class="text-xs text-gray-400 hover:text-rose-600 underline font-semibold transition-colors cursor-pointer"
                >
                  Reiniciar selección de bowls
                </button>
              </div>

            </div>

          </div>

          <!-- TAB 2: NUTRICIÓN VIEW -->
          <div id="tab-content-nutricion" class="hidden space-y-8">
            <div class="max-w-3xl mx-auto space-y-6">
              <div class="text-center space-y-2">
                <h3 class="font-serif font-bold text-2xl text-gray-900">Tabla Nutricional & Balance</h3>
                <p class="text-sm text-gray-500">Nuestros bowls están formulados por profesionales de la nutrición para aportar energía limpia y saciedad.</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Salteado info -->
                <div class="p-6 rounded-3xl bg-[#FAF6F0] border border-brand-gold/20 space-y-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-[#B8935B] text-white flex items-center justify-center font-bold">
                      🔥
                    </div>
                    <div>
                      <h4 class="font-bold text-lg text-gray-900">Bowl Salteado</h4>
                      <span class="text-xs text-gray-500">Aporte calórico aprox: ~480 kcal</span>
                    </div>
                  </div>
                  <ul class="space-y-2 text-xs text-gray-700">
                    <li>• <strong>Proteína de alto valor biológico:</strong> ~35g</li>
                    <li>• <strong>Carbohidratos complejos (Quinua Real):</strong> ~55g</li>
                    <li>• <strong>Grasas saludables & fibra:</strong> ~12g</li>
                  </ul>
                </div>

                <!-- Fresco info -->
                <div class="p-6 rounded-3xl bg-[#FAF6F0] border border-brand-gold/20 space-y-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-emerald-600 text-white flex items-center justify-center font-bold">
                      🍃
                    </div>
                    <div>
                      <h4 class="font-bold text-lg text-gray-900">Bowl Fresco</h4>
                      <span class="text-xs text-gray-500">Aporte calórico aprox: ~420 kcal</span>
                    </div>
                  </div>
                  <ul class="space-y-2 text-xs text-gray-700">
                    <li>• <strong>Proteína magra:</strong> ~34g</li>
                    <li>• <strong>Carbohidratos & fibra digestiva:</strong> ~45g</li>
                    <li>• <strong>Micronutrientes & antioxidantes:</strong> Alto contenido en Vitamina A, C y K</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>

    </main>

  </div>

  <!-- Reusable Global Footer -->
  <Footer />
</Layout>

<script is:inline define:vars={{ baseWhatsappLink, availableBowls, availableProteins }}>
  const isMobileDev = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  
  // Pricing matrix
  const ALL_WEEK_DAYS = [
    { key: "lun", short: "Lun", label: "Lunes", num: "01", dayIndex: 0 },
    { key: "mar", short: "Mar", label: "Martes", num: "02", dayIndex: 1 },
    { key: "mie", short: "Mié", label: "Miércoles", num: "03", dayIndex: 2 },
    { key: "jue", short: "Jue", label: "Jueves", num: "04", dayIndex: 3 },
    { key: "vie", short: "Vie", label: "Viernes", num: "05", dayIndex: 4 }
  ];

  const planPrices = {
    diario: {
      mediano: { individual: 24, grupal: 24 },
      grande: { individual: 37, grupal: 37 }
    },
    flexible: {
      mediano: { individual: 69, grupal: 207 },
      grande: { individual: 108, grupal: 324 }
    },
    semanal: {
      mediano: { individual: 110, grupal: 330 },
      grande: { individual: 175, grupal: 525 }
    },
    mensual: {
      mediano: { individual: 400, grupal: 1200 },
      grande: { individual: 660, grupal: 1980 }
    }
  };

  const planTitles = {
    diario: 'Plan Diario (1 Bowl)',
    flexible: 'Plan Flexible (3 Bowls)',
    semanal: 'Plan Semanal (5 Bowls)',
    mensual: 'Plan Mensual (20 Bowls)'
  };

  const planDescriptions = {
    diario: 'Consta de <strong>1 bowl</strong> puntual que puedes programar para el día que desees.',
    flexible: 'Consta de <strong>3 bowls</strong> en la semana. Puedes <strong>elegir libremente tus 3 días</strong> de entrega.',
    semanal: 'Consta de <strong>5 bowls</strong> de lunes a viernes para cubrir toda tu semana.',
    mensual: 'Consta de <strong>20 bowls</strong> programados en un ciclo base de lunes a viernes durante <strong>4 semanas</strong>.'
  };

  // State
  let selectedSize = 'mediano';
  let selectedFreq = 'semanal';
  let selectedOption = 'individual';
  let currentActiveDayIndex = 0;
  
  // Custom days per frequency
  let chosenDaysByFreq = {
    diario: ['lun'],
    flexible: ['lun', 'mie', 'vie'],
    semanal: ['lun', 'mar', 'mie', 'jue', 'vie'],
    mensual: ['lun', 'mar', 'mie', 'jue', 'vie']
  };

  let activePlanDays = [];
  let planChoices = {};

  // DOM Elements
  const customerNameInput = document.getElementById('customer-name');
  const customerAddressInput = document.getElementById('customer-address');
  const mainPlanTitle = document.getElementById('main-plan-title');
  const planDescriptionBanner = document.getElementById('plan-description-banner');
  const optionSelectorWrapper = document.getElementById('option-selector-wrapper');
  
  const daysPickerTitle = document.getElementById('days-picker-title');
  const daysPickerSubtitle = document.getElementById('days-picker-subtitle');
  const daysCountBadge = document.getElementById('days-count-badge');
  const daysButtonsPicker = document.getElementById('days-buttons-picker');
  const daysHelperText = document.getElementById('days-helper-text');
  
  const daySelectionBadge = document.getElementById('day-selection-badge');
  const btnSaveDay = document.getElementById('btn-save-day');
  const btnSaveDayText = document.getElementById('btn-save-day-text');
  const baseCarbDesc = document.getElementById('base-carb-desc');
  const baseVegDesc = document.getElementById('base-veg-desc');
  
  const sidebarPlanLabel = document.getElementById('sidebar-plan-label');
  const sidebarPriceDisplay = document.getElementById('sidebar-price-display');
  const sidebarSizeDesc = document.getElementById('sidebar-size-desc');
  const progressCounterBadge = document.getElementById('progress-counter-badge');
  const progressBarFill = document.getElementById('progress-bar-fill');
  const summaryDaysList = document.getElementById('summary-days-list');
  const daysSelectorContainer = document.getElementById('days-selector-container');
  
  const btnConfirmWhatsapp = document.getElementById('btn-confirm-whatsapp');
  const validationHelpText = document.getElementById('validation-help-text');
  const btnResetPlan = document.getElementById('btn-reset-plan');

  // Tabs
  const tabBtnPersonalizar = document.getElementById('tab-btn-personalizar');
  const tabBtnNutricion = document.getElementById('tab-btn-nutricion');
  const tabContentPersonalizar = document.getElementById('tab-content-personalizar');
  const tabContentNutricion = document.getElementById('tab-content-nutricion');

  tabBtnPersonalizar?.addEventListener('click', () => {
    tabBtnPersonalizar.className = "py-4 px-4 sm:px-6 text-[#8A6F56] border-b-2 border-[#B8935B] flex items-center gap-2 cursor-pointer transition-colors";
    tabBtnNutricion.className = "py-4 px-4 sm:px-6 text-gray-400 hover:text-gray-600 border-b-2 border-transparent flex items-center gap-2 cursor-pointer transition-colors";
    tabContentPersonalizar?.classList.remove('hidden');
    tabContentNutricion?.classList.add('hidden');
  });

  tabBtnNutricion?.addEventListener('click', () => {
    tabBtnNutricion.className = "py-4 px-4 sm:px-6 text-[#8A6F56] border-b-2 border-[#B8935B] flex items-center gap-2 cursor-pointer transition-colors";
    tabBtnPersonalizar.className = "py-4 px-4 sm:px-6 text-gray-400 hover:text-gray-600 border-b-2 border-transparent flex items-center gap-2 cursor-pointer transition-colors";
    tabContentPersonalizar?.classList.add('hidden');
    tabContentNutricion?.classList.remove('hidden');
  });

  // Render Days Picker Widget (Section for choosing which days to deliver)
  function renderDaysPickerWidget() {
    if (!daysButtonsPicker) return;
    daysButtonsPicker.innerHTML = '';

    const currentChosen = chosenDaysByFreq[selectedFreq] || ['lun', 'mar', 'mie', 'jue', 'vie'];

    if (selectedFreq === 'diario') {
      if (daysPickerTitle) daysPickerTitle.textContent = "📅 ¿Qué día deseas recibir tu bowl? (1 día):";
      if (daysPickerSubtitle) daysPickerSubtitle.textContent = "Selecciona el día de la semana para tu entrega puntual";
      if (daysCountBadge) daysCountBadge.textContent = "1 de 1 día seleccionado";
      if (daysHelperText) daysHelperText.textContent = "Haz clic en el día que prefieras para cambiar la entrega.";

      ALL_WEEK_DAYS.forEach(day => {
        const isSelected = currentChosen.includes(day.key);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = isSelected
          ? 'py-2.5 sm:py-3 px-2 rounded-2xl bg-[#B8935B] text-white border-2 border-[#B8935B] font-bold text-xs sm:text-sm flex flex-col items-center justify-center gap-0.5 shadow-sm cursor-pointer transition-all transform scale-102'
          : 'py-2.5 sm:py-3 px-2 rounded-2xl bg-[#FAF6F0]/60 text-gray-700 border border-gray-200 hover:border-[#B8935B] hover:bg-white font-semibold text-xs sm:text-sm flex flex-col items-center justify-center gap-0.5 cursor-pointer transition-all';
        
        btn.innerHTML = `
          <span class="text-xs uppercase tracking-wider">${day.short}</span>
          <span class="text-[10px] opacity-80">${isSelected ? 'Seleccionado' : 'Elegir'}</span>
        `;

        btn.addEventListener('click', () => {
          chosenDaysByFreq.diario = [day.key];
          updatePlanConfiguration();
        });

        daysButtonsPicker.appendChild(btn);
      });

    } else if (selectedFreq === 'flexible') {
      const count = currentChosen.length;
      if (daysPickerTitle) daysPickerTitle.textContent = "📅 Elige tus 3 días de entrega en la semana:";
      if (daysPickerSubtitle) daysPickerSubtitle.textContent = "Marca los 3 días que más te convengan (ej. Lun, Mar y Jue)";
      if (daysCountBadge) daysCountBadge.textContent = `${count} de 3 días seleccionados`;
      if (daysHelperText) daysHelperText.textContent = count === 3 
        ? "¡Perfecto! Ya tienes 3 días. Si quieres cambiar uno, haz clic sobre el día que deseas desmarcar."
        : `Selecciona ${3 - count} día(s) más para completar tus 3 entregas.`;

      ALL_WEEK_DAYS.forEach(day => {
        const isSelected = currentChosen.includes(day.key);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = isSelected
          ? 'py-2.5 sm:py-3 px-2 rounded-2xl bg-[#B8935B] text-white border-2 border-[#B8935B] font-bold text-xs sm:text-sm flex flex-col items-center justify-center gap-0.5 shadow-sm cursor-pointer transition-all transform scale-102'
          : 'py-2.5 sm:py-3 px-2 rounded-2xl bg-[#FAF6F0]/60 text-gray-700 border border-gray-200 hover:border-[#B8935B] hover:bg-white font-semibold text-xs sm:text-sm flex flex-col items-center justify-center gap-0.5 cursor-pointer transition-all';
        
        btn.innerHTML = `
          <span class="text-xs uppercase tracking-wider font-extrabold flex items-center gap-1">
            ${isSelected ? '✓ ' : ''}${day.short}
          </span>
          <span class="text-[10px] ${isSelected ? 'text-amber-100 font-bold' : 'text-gray-400'}">
            ${isSelected ? 'Incluido' : 'Sumar'}
          </span>
        `;

        btn.addEventListener('click', () => {
          if (isSelected) {
            if (currentChosen.length > 1) {
              chosenDaysByFreq.flexible = currentChosen.filter(k => k !== day.key);
              updatePlanConfiguration();
            }
          } else {
            if (currentChosen.length < 3) {
              const newArr = [...currentChosen, day.key];
              // Sort according to weekday order
              newArr.sort((a, b) => {
                const idxA = ALL_WEEK_DAYS.findIndex(d => d.key === a);
                const idxB = ALL_WEEK_DAYS.findIndex(d => d.key === b);
                return idxA - idxB;
              });
              chosenDaysByFreq.flexible = newArr;
              updatePlanConfiguration();
            } else {
              // If already 3, replace the first one or prompt
              const newArr = [currentChosen[1], currentChosen[2], day.key];
              newArr.sort((a, b) => {
                const idxA = ALL_WEEK_DAYS.findIndex(d => d.key === a);
                const idxB = ALL_WEEK_DAYS.findIndex(d => d.key === b);
                return idxA - idxB;
              });
              chosenDaysByFreq.flexible = newArr;
              updatePlanConfiguration();
            }
          }
        });

        daysButtonsPicker.appendChild(btn);
      });

    } else if (selectedFreq === 'semanal') {
      if (daysPickerTitle) daysPickerTitle.textContent = "📅 Días de entrega: Lunes a Viernes";
      if (daysPickerSubtitle) daysPickerSubtitle.textContent = "Tu plan semanal cubre todos los almuerzos de lunes a viernes";
      if (daysCountBadge) daysCountBadge.textContent = "5 de 5 días (Semana completa)";
      if (daysHelperText) daysHelperText.textContent = "El plan semanal incluye los 5 días hábiles continuos.";

      ALL_WEEK_DAYS.forEach(day => {
        const btn = document.createElement('div');
        btn.className = 'py-2.5 sm:py-3 px-2 rounded-2xl bg-[#FAF6F0] text-gray-900 border border-brand-gold/40 font-bold text-xs sm:text-sm flex flex-col items-center justify-center gap-0.5 opacity-90';
        btn.innerHTML = `
          <span class="text-xs uppercase tracking-wider flex items-center gap-1">✓ ${day.short}</span>
          <span class="text-[10px] text-[#8A6F56] font-medium">Incluido</span>
        `;
        daysButtonsPicker.appendChild(btn);
      });

    } else if (selectedFreq === 'mensual') {
      if (daysPickerTitle) daysPickerTitle.textContent = "📅 Días de entrega: Lunes a Viernes (Ciclo mensual)";
      if (daysPickerSubtitle) daysPickerSubtitle.textContent = "Configuras tu menú base semanal de 5 días que se repetirá durante 4 semanas (20 bowls)";
      if (daysCountBadge) daysCountBadge.textContent = "5 días base (4 semanas = 20 bowls)";
      if (daysHelperText) daysHelperText.textContent = "Menú semanal base. Podrás coordinar variaciones semana a semana por WhatsApp.";

      ALL_WEEK_DAYS.forEach(day => {
        const btn = document.createElement('div');
        btn.className = 'py-2.5 sm:py-3 px-2 rounded-2xl bg-[#FAF6F0] text-gray-900 border border-brand-gold/40 font-bold text-xs sm:text-sm flex flex-col items-center justify-center gap-0.5 opacity-90';
        btn.innerHTML = `
          <span class="text-xs uppercase tracking-wider flex items-center gap-1">✓ ${day.short}</span>
          <span class="text-[10px] text-[#8A6F56] font-medium">Ciclo base</span>
        `;
        daysButtonsPicker.appendChild(btn);
      });
    }
  }

  // Initialize and switch plan
  function updatePlanConfiguration() {
    const keys = chosenDaysByFreq[selectedFreq] || ['lun', 'mar', 'mie', 'jue', 'vie'];
    activePlanDays = keys.map((k, idx) => {
      const found = ALL_WEEK_DAYS.find(d => d.key === k) || { key: k, short: k.toUpperCase(), label: k, num: `0${idx+1}` };
      return {
        ...found,
        num: `0${idx + 1}`
      };
    });
    
    // Ensure choice keys exist
    activePlanDays.forEach(d => {
      if (!planChoices[d.key]) {
        planChoices[d.key] = { bowlId: '', bowlName: '', protein: '' };
      }
    });

    if (currentActiveDayIndex >= activePlanDays.length) {
      currentActiveDayIndex = 0;
    }

    // Hide/Show option selector (Grupal/Individual) for Diario
    if (optionSelectorWrapper) {
      if (selectedFreq === 'diario') {
        optionSelectorWrapper.classList.add('opacity-40', 'pointer-events-none');
      } else {
        optionSelectorWrapper.classList.remove('opacity-40', 'pointer-events-none');
      }
    }

    // Update Header texts
    if (mainPlanTitle) {
      mainPlanTitle.textContent = `Arma tus Bowls · ${planTitles[selectedFreq]}`;
    }
    if (planDescriptionBanner) {
      planDescriptionBanner.innerHTML = planDescriptions[selectedFreq];
    }

    // Render Days Picker Widget
    renderDaysPickerWidget();

    // Render Day Selector Grid
    renderDaySelectors();

    // Render Sidebar list
    renderSidebarDays();

    // Update Pricing & texts
    updatePricingAndSummary();

    // Select active day
    if (activePlanDays.length > 0) {
      selectDay(currentActiveDayIndex);
    }
  }

  function renderDaySelectors() {
    if (!daysSelectorContainer) return;

    const count = activePlanDays.length;
    let gridColsClass = 'grid-cols-5';
    if (count === 1) gridColsClass = 'grid-cols-1 max-w-xs';
    else if (count === 2) gridColsClass = 'grid-cols-2 max-w-sm';
    else if (count === 3) gridColsClass = 'grid-cols-3 max-w-md';
    else if (count === 4) gridColsClass = 'grid-cols-4 max-w-lg';

    daysSelectorContainer.className = `grid ${gridColsClass} gap-2 sm:gap-3`;
    daysSelectorContainer.innerHTML = '';

    activePlanDays.forEach((day, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'day-tab-btn relative flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border border-gray-200 bg-white hover:border-[#B8935B] cursor-pointer transition-all duration-200';
      btn.dataset.dayKey = day.key;
      btn.dataset.dayIndex = idx.toString();
      btn.innerHTML = `
        <span class="day-short text-xs font-bold text-gray-500 uppercase">${day.short}</span>
        <span class="day-number text-lg sm:text-2xl font-black text-gray-900 my-0.5">${day.num}</span>
        <span class="day-status-text text-[10px] font-semibold text-gray-400">Elegir</span>
        <div class="day-saved-indicator hidden absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-[#B8935B] text-white flex items-center justify-center shadow-xs text-[10px] font-bold">✓</div>
      `;
      btn.addEventListener('click', () => selectDay(idx));
      daysSelectorContainer.appendChild(btn);
    });
  }

  function renderSidebarDays() {
    if (!summaryDaysList) return;
    summaryDaysList.innerHTML = '';

    activePlanDays.forEach((day, idx) => {
      const row = document.createElement('div');
      row.className = 'summary-day-row p-3 rounded-xl bg-white border border-gray-200/80 hover:border-[#B8935B] cursor-pointer transition-all flex items-center justify-between gap-3 group shadow-2xs';
      row.dataset.dayKey = day.key;
      row.dataset.dayIndex = idx.toString();
      row.innerHTML = `
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="w-6 h-6 rounded-lg bg-[#FAF6F0] text-gray-700 font-bold text-xs flex items-center justify-center shrink-0 group-hover:bg-[#B8935B] group-hover:text-white transition-colors">
            ${day.short}
          </span>
          <div class="min-w-0">
            <span class="text-xs font-bold text-gray-900 block truncate">${day.label}</span>
            <span class="text-[11px] text-gray-400 block truncate summary-day-desc" id="summary-desc-${day.key}">Por elegir</span>
          </div>
        </div>
        <span class="text-[11px] font-bold text-[#8A6F56] shrink-0 group-hover:underline">Editar</span>
      `;
      row.addEventListener('click', () => selectDay(idx));
      summaryDaysList.appendChild(row);
    });
  }

  function selectDay(index) {
    currentActiveDayIndex = index;
    const day = activePlanDays[index];
    if (!day) return;
    const key = day.key;
    const choice = planChoices[key] || { bowlId: '', bowlName: '', protein: '' };

    if (daySelectionBadge) daySelectionBadge.textContent = `${day.label} seleccionado`;
    if (btnSaveDayText) btnSaveDayText.textContent = `Guardar elección del ${day.label.toLowerCase()}`;

    // Update Day Tab Buttons UI
    document.querySelectorAll('.day-tab-btn').forEach((btn, idx) => {
      const btnKey = btn.dataset.dayKey;
      const isSaved = planChoices[btnKey] && planChoices[btnKey].bowlId && planChoices[btnKey].protein;
      const indicator = btn.querySelector('.day-saved-indicator');

      if (indicator) {
        if (isSaved) indicator.classList.remove('hidden');
        else indicator.classList.add('hidden');
      }

      if (idx === index) {
        btn.className = "day-tab-btn relative flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border-2 border-[#B8935B] bg-[#FAF6F0] shadow-sm cursor-pointer transition-all duration-200 transform scale-102";
        const shortEl = btn.querySelector('.day-short');
        const numEl = btn.querySelector('.day-number');
        const statusEl = btn.querySelector('.day-status-text');
        if (shortEl) shortEl.className = "day-short text-xs font-black text-[#8A6F56] uppercase";
        if (numEl) numEl.className = "day-number text-lg sm:text-2xl font-black text-gray-950 my-0.5";
        if (statusEl) {
          statusEl.className = "day-status-text text-[10px] font-bold text-[#B8935B]";
          statusEl.textContent = isSaved ? "Listo ✓" : "Eligiendo";
        }
      } else {
        btn.className = "day-tab-btn relative flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border border-gray-200 bg-white hover:border-[#B8935B] cursor-pointer transition-all duration-200";
        const shortEl = btn.querySelector('.day-short');
        const numEl = btn.querySelector('.day-number');
        const statusEl = btn.querySelector('.day-status-text');
        if (shortEl) shortEl.className = "day-short text-xs font-bold text-gray-500 uppercase";
        if (numEl) numEl.className = "day-number text-lg sm:text-2xl font-black text-gray-900 my-0.5";
        if (statusEl) {
          statusEl.className = "day-status-text text-[10px] font-semibold text-gray-400";
          statusEl.textContent = isSaved ? "Listo ✓" : "Elegir";
        }
      }
    });

    // Populate radio options for this day
    document.querySelectorAll('.bowl-radio').forEach(r => {
      r.checked = (r.value === choice.bowlId);
    });
    document.querySelectorAll('.protein-radio').forEach(r => {
      r.checked = (r.value === choice.protein);
    });

    updateBowlCardsUI();
    updateProteinCardsUI();
    checkCurrentDayCompleteness();
    updatePricingAndSummary();
  }

  function updateBowlCardsUI() {
    document.querySelectorAll('.bowl-option-card').forEach(card => {
      const radio = card.querySelector('.bowl-radio');
      const circle = card.querySelector('.bowl-check-circle');
      const checkText = circle ? circle.querySelector('span') : null;

      if (radio && radio.checked) {
        card.classList.remove('border-gray-200', 'bg-white');
        card.classList.add('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        if (circle) {
          circle.classList.remove('border-gray-300');
          circle.classList.add('border-[#B8935B]', 'bg-[#B8935B]');
        }
        if (checkText) checkText.classList.remove('hidden');

        const bowlObj = availableBowls.find(b => b.id === radio.value);
        if (bowlObj) {
          if (baseCarbDesc) baseCarbDesc.textContent = bowlObj.carb;
          if (baseVegDesc) baseVegDesc.textContent = bowlObj.veg;
        }
      } else {
        card.classList.remove('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        card.classList.add('border-gray-200', 'bg-white');
        if (circle) {
          circle.classList.remove('border-[#B8935B]', 'bg-[#B8935B]');
          circle.classList.add('border-gray-300');
        }
        if (checkText) checkText.classList.add('hidden');
      }
    });
  }

  function updateProteinCardsUI() {
    document.querySelectorAll('.protein-option-card').forEach(card => {
      const radio = card.querySelector('.protein-radio');
      const circle = card.querySelector('.protein-check-circle');
      const checkText = circle ? circle.querySelector('span') : null;

      if (radio && radio.checked) {
        card.classList.remove('border-gray-200', 'bg-white');
        card.classList.add('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        if (circle) {
          circle.classList.remove('border-gray-300');
          circle.classList.add('border-[#B8935B]', 'bg-[#B8935B]');
        }
        if (checkText) checkText.classList.remove('hidden');
      } else {
        card.classList.remove('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        card.classList.add('border-gray-200', 'bg-white');
        if (circle) {
          circle.classList.remove('border-[#B8935B]', 'bg-[#B8935B]');
          circle.classList.add('border-gray-300');
        }
        if (checkText) checkText.classList.add('hidden');
      }
    });
  }

  function checkCurrentDayCompleteness() {
    const selectedBowlRadio = document.querySelector('.bowl-radio:checked');
    const selectedProteinRadio = document.querySelector('.protein-radio:checked');
    const day = activePlanDays[currentActiveDayIndex];
    if (!day) return;
    const dayKey = day.key;

    if (selectedBowlRadio && selectedProteinRadio) {
      const bowlObj = availableBowls.find(b => b.id === selectedBowlRadio.value);
      const bowlName = bowlObj ? bowlObj.name : selectedBowlRadio.value;
      
      planChoices[dayKey] = {
        bowlId: selectedBowlRadio.value,
        bowlName: bowlName,
        protein: selectedProteinRadio.value
      };

      if (btnSaveDay) {
        btnSaveDay.classList.remove('opacity-50', 'pointer-events-none');
      }
    } else {
      if (btnSaveDay) {
        btnSaveDay.classList.add('opacity-50', 'pointer-events-none');
      }
    }
  }

  function updatePricingAndSummary() {
    const currentPrice = planPrices[selectedFreq][selectedSize][selectedOption];
    const sizeLabel = selectedSize === 'mediano' ? 'Mediano (~400g)' : 'Grande (~650g)';
    const freqLabel = planTitles[selectedFreq];
    const optionLabel = selectedFreq === 'diario' ? '' : (selectedOption === 'individual' ? 'Individual' : 'Grupal (3+ pers.)');

    if (sidebarPlanLabel) sidebarPlanLabel.textContent = `${freqLabel} ${optionLabel ? '• ' + optionLabel : ''}`;
    if (sidebarPriceDisplay) sidebarPriceDisplay.textContent = `Bs. ${currentPrice}`;
    if (sidebarSizeDesc) sidebarSizeDesc.textContent = `Tamaño ${sizeLabel}`;

    // Update items in sidebar list
    let completedCount = 0;
    const totalDays = activePlanDays.length;

    activePlanDays.forEach(day => {
      const choice = planChoices[day.key];
      const descEl = document.getElementById(`summary-desc-${day.key}`);
      
      if (choice && choice.bowlId && choice.protein) {
        completedCount++;
        if (descEl) {
          descEl.textContent = `${choice.bowlName} • ${choice.protein}`;
          descEl.className = "text-[11px] font-bold text-[#8A6F56] block truncate summary-day-desc";
        }
      } else {
        if (descEl) {
          descEl.textContent = "Por elegir";
          descEl.className = "text-[11px] text-gray-400 block truncate summary-day-desc";
        }
      }
    });

    if (progressCounterBadge) progressCounterBadge.textContent = `${completedCount} de ${totalDays}`;
    if (progressBarFill) progressBarFill.style.width = `${totalDays > 0 ? (completedCount / totalDays) * 100 : 0}%`;

    const isAllCompleted = (totalDays > 0 && completedCount === totalDays);
    const customerName = customerNameInput ? customerNameInput.value.trim() : '';

    if (btnConfirmWhatsapp && validationHelpText) {
      if (isAllCompleted && customerName.length > 0) {
        btnConfirmWhatsapp.classList.remove('opacity-50', 'pointer-events-none', 'cursor-not-allowed');
        btnConfirmWhatsapp.classList.add('hover:-translate-y-0.5', 'active:scale-98');
        validationHelpText.textContent = "¡Menú listo! Haz clic para enviar tu pedido a WhatsApp.";
        validationHelpText.className = "text-[11px] text-center text-[#8A6F56] font-bold";

        const message = buildWhatsappMessage();
        const isMobileDev = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        const finalBase = isMobileDev ? baseWhatsappLink : baseWhatsappLink.replace('api.whatsapp.com/send', 'web.whatsapp.com/send');
        btnConfirmWhatsapp.href = `${finalBase}&text=${encodeURIComponent(message)}`;
      } else {
        btnConfirmWhatsapp.classList.add('opacity-50', 'pointer-events-none', 'cursor-not-allowed');
        btnConfirmWhatsapp.classList.remove('hover:-translate-y-0.5', 'active:scale-98');
        
        if (!customerName) {
          validationHelpText.textContent = "Por favor ingresa tu nombre arriba para continuar.";
          validationHelpText.className = "text-[11px] text-center text-amber-700 font-semibold";
        } else {
          const remaining = totalDays - completedCount;
          validationHelpText.textContent = `Completa los ${remaining} bowls pendientes para continuar.`;
          validationHelpText.className = "text-[11px] text-center text-gray-400 font-medium";
        }
      }
    }
  }

  function buildWhatsappMessage() {
    const customerName = customerNameInput ? customerNameInput.value.trim() : 'Cliente';
    const customerAddress = customerAddressInput ? customerAddressInput.value.trim() : '';
    const currentPrice = planPrices[selectedFreq][selectedSize][selectedOption];
    const sizeLabel = selectedSize === 'mediano' ? 'Mediano (~400g de balance)' : 'Grande (~650g de rendimiento)';
    const freqLabel = planTitles[selectedFreq];
    const optionLabel = selectedFreq === 'diario' ? '' : (selectedOption === 'individual' ? 'Individual (1 persona)' : 'Grupal (desde 3 personas)');

    const currentYear = new Date().getFullYear();
    if (!window._mcFolioNumber) {
      window._mcFolioNumber = Math.floor(1000 + Math.random() * 9000);
    }
    const orderFolioCode = `#MC-${currentYear}-${window._mcFolioNumber}`;

    // Generate Ultra-Compact URL for the Digital Sheet
    let comandaUrl = '';
    try {
      const proteinCodeMap = {
        "Pollo a la Plancha": "1",
        "Albóndigas de Carne (Air Fryer)": "2",
        "Huevos Hervidos": "3"
      };

      const planCode = activePlanDays.map(d => {
        const c = planChoices[d.key] || { bowlId: 'salteado', protein: 'Pollo a la Plancha' };
        const bCode = (c.bowlId === 'fresco') ? 'f' : 's';
        const pCode = proteinCodeMap[c.protein] || '1';
        return `${bCode}${pCode}`;
      }).join('-');

      const daysParam = activePlanDays.map(d => d.key).join(',');

      const params = new URLSearchParams();
      params.set('c', customerName);
      if (customerAddress) params.set('dir', customerAddress);
      params.set('f', window._mcFolioNumber.toString());
      params.set('p', planCode);
      params.set('d', daysParam);
      params.set('sz', selectedSize);
      params.set('pl', selectedFreq);
      params.set('op', selectedOption);

      comandaUrl = `${window.location.origin}/comanda?${params.toString()}`;
    } catch(e) {
      comandaUrl = `${window.location.origin}/comanda`;
    }

    const daysNamesList = activePlanDays.map(d => d.label).join(', ');

    let msg = `🥗 *¡FICHA & PEDIDO - MONTALVO CATERING!* \n`;
    msg += `🔖 *Código de Pedido:* ${orderFolioCode}\n`;
    msg += `----------------------------------------\n`;
    msg += `👤 *Cliente:* ${customerName}\n`;
    if (customerAddress) {
      msg += `📍 *Dirección:* ${customerAddress}\n`;
    }
    msg += `📦 *Plan:* ${freqLabel}\n`;
    if (optionLabel) {
      msg += `👥 *Modalidad:* ${optionLabel}\n`;
    }
    msg += `⚖️ *Tamaño:* ${sizeLabel}\n`;
    msg += `🗓️ *Días de Entrega:* ${daysNamesList}\n`;
    msg += `💰 *Total a pagar:* Bs. ${currentPrice}\n`;
    if (comandaUrl) {
      msg += `\n📄 *FICHA OFICIAL / COMANDA EN PDF:* \n👉 ${comandaUrl}\n`;
    }
    msg += `----------------------------------------\n`;
    msg += `🗓️ *MENÚ PERSONALIZADO:*\n\n`;

    activePlanDays.forEach(day => {
      const choice = planChoices[day.key] || {};
      msg += `📅 *${day.label.toUpperCase()}:*\n`;
      msg += `  • *Bowl:* ${choice.bowlName || 'Bowl Salteado'}\n`;
      msg += `  • *Proteína:* ${choice.protein || 'Pollo a la Plancha'}\n\n`;
    });

    msg += `----------------------------------------\n`;
    msg += `_Configurado desde Montalvo Catering Web_`;

    return msg;
  }

  // Size Selector Click Listeners
  document.querySelectorAll('.size-selector-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      selectedSize = e.currentTarget.dataset.size;
      document.querySelectorAll('.size-selector-btn').forEach(b => {
        if (b.dataset.size === selectedSize) {
          b.className = "size-selector-btn py-2.5 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs";
        } else {
          b.className = "size-selector-btn py-2.5 px-3 rounded-xl text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all cursor-pointer";
        }
      });
      updatePricingAndSummary();
    });
  });

  // Freq Selector Click Listeners
  document.querySelectorAll('.freq-selector-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      selectedFreq = e.currentTarget.dataset.freq;
      document.querySelectorAll('.freq-selector-btn').forEach(b => {
        if (b.dataset.freq === selectedFreq) {
          b.className = "freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-extrabold text-center transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs";
        } else {
          b.className = "freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-semibold text-gray-600 hover:text-gray-900 text-center transition-all cursor-pointer";
        }
      });
      updatePlanConfiguration();
    });
  });

  // Option Selector Click Listeners
  document.querySelectorAll('.option-selector-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      selectedOption = e.currentTarget.dataset.option;
      document.querySelectorAll('.option-selector-btn').forEach(b => {
        if (b.dataset.option === selectedOption) {
          b.className = "option-selector-btn py-2.5 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs";
        } else {
          b.className = "option-selector-btn py-2.5 px-3 rounded-xl text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all cursor-pointer";
        }
      });
      updatePricingAndSummary();
    });
  });

  // Bowl radio selection
  document.querySelectorAll('.bowl-radio').forEach(radio => {
    radio.addEventListener('change', () => {
      updateBowlCardsUI();
      checkCurrentDayCompleteness();
      updatePricingAndSummary();
    });
  });

  // Protein radio selection
  document.querySelectorAll('.protein-radio').forEach(radio => {
    radio.addEventListener('change', () => {
      updateProteinCardsUI();
      checkCurrentDayCompleteness();
      updatePricingAndSummary();
    });
  });

  btnSaveDay?.addEventListener('click', () => {
    checkCurrentDayCompleteness();
    updatePricingAndSummary();

    let nextIdx = -1;
    for (let i = 0; i < activePlanDays.length; i++) {
      const k = activePlanDays[i].key;
      if (!planChoices[k] || !planChoices[k].bowlId || !planChoices[k].protein) {
        nextIdx = i;
        break;
      }
    }

    if (nextIdx !== -1) {
      selectDay(nextIdx);
    } else {
      const next = (currentActiveDayIndex + 1) % activePlanDays.length;
      selectDay(next);
    }
  });

  customerNameInput?.addEventListener('input', () => {
    updatePricingAndSummary();
  });
  customerAddressInput?.addEventListener('input', () => {
    updatePricingAndSummary();
  });

  btnResetPlan?.addEventListener('click', () => {
    if (confirm('¿Estás seguro de reiniciar la selección de bowls?')) {
      planChoices = {};
      updatePlanConfiguration();
    }
  });

  // Init
  updatePlanConfiguration();
</script>
