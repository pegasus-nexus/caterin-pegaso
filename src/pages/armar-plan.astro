<script is:inline define:vars={{ baseWhatsappLink, availableBowls, availableProteins }}>
  const isMobileDev = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  
  const monthNames = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
  const fullMonthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
  const dayNames = ["Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"];
  const dayShortNames = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];

  // Helper to construct full day info from ISO key "YYYY-MM-DD"
  function getDayInfoFromIso(isoKey) {
    const parts = isoKey.split('-');
    const y = parseInt(parts[0], 10);
    const m = parseInt(parts[1], 10) - 1;
    const d = parseInt(parts[2], 10);
    const dateObj = new Date(y, m, d);
    const dayOfWeek = dateObj.getDay();
    const dPad = String(d).padStart(2, '0');
    const mPad = String(m + 1).padStart(2, '0');

    return {
      key: isoKey,
      isoKey: isoKey,
      dateStr: `${dPad}/${mPad}/${y}`,
      dayOfWeek: dayOfWeek,
      dayName: dayNames[dayOfWeek],
      short: `${dayShortNames[dayOfWeek]} ${dPad}`,
      dayShort: dayShortNames[dayOfWeek].toUpperCase(),
      dayNum: dPad,
      monthShort: monthNames[m].toUpperCase(),
      label: `${dayNames[dayOfWeek]} ${dPad} de ${monthNames[m]}`,
      rawDate: dateObj
    };
  }

  // Pre-generate initial delivery dates starting from today or tomorrow
  function generateInitialKeys() {
    const keys = [];
    const now = new Date();
    let cur = new Date(now);
    if (now.getHours() >= 15) {
      cur.setDate(cur.getDate() + 1);
    }
    while (keys.length < 10) {
      const dow = cur.getDay();
      if (dow >= 1 && dow <= 5) {
        const y = cur.getFullYear();
        const m = String(cur.getMonth() + 1).padStart(2, '0');
        const d = String(cur.getDate()).padStart(2, '0');
        keys.push(`${y}-${m}-${d}`);
      }
      cur.setDate(cur.getDate() + 1);
    }
    return keys;
  }

  const initialBusinessKeys = generateInitialKeys();

  // Pricing matrix
  const planPrices = {
    diario: {
      mediano: { individual: 24, grupal: 24 },
      grande: { individual: 37, grupal: 37 }
    },
    flexible: {
      mediano: { individual: 69, grupal: 207 },
      grande: { individual: 108, grupal: 324 }
    },
    semanal: {
      mediano: { individual: 110, grupal: 330 },
      grande: { individual: 175, grupal: 525 }
    },
    mensual: {
      mediano: { individual: 400, grupal: 1200 },
      grande: { individual: 660, grupal: 1980 }
    }
  };

  const planTitles = {
    diario: 'Plan Diario (1 Bowl)',
    flexible: 'Plan Flexible (3 Bowls)',
    semanal: 'Plan Semanal (5 Bowls)',
    mensual: 'Plan Mensual (20 Bowls)'
  };

  const planTargetBowls = {
    diario: 1,
    flexible: 3,
    semanal: 5,
    mensual: 5 // 5 base cycle for monthly
  };

  const planDescriptions = {
    diario: 'Consta de <strong>1 bowl</strong> puntual que puedes programar para cualquier fecha disponible en el calendario.',
    flexible: 'Consta de <strong>3 bowls</strong> que puedes consumir durante el periodo de <strong>hasta 2 semanas</strong> a tu libre elección.',
    semanal: 'Consta de <strong>5 bowls</strong> que puedes consumir durante el periodo de <strong>hasta 2 semanas</strong> para 1 persona (ej. 2 esta semana y 3 la próxima).',
    mensual: 'Consta de <strong>20 bowls</strong> programados para disfrutar durante un periodo de <strong>hasta 6 semanas</strong>.'
  };

  // State
  let selectedSize = 'mediano';
  let selectedFreq = 'semanal';
  let selectedOption = 'individual';
  let currentActiveDayIndex = 0;

  let currentViewYear = new Date().getFullYear();
  let currentViewMonth = new Date().getMonth();
  
  // Selected real dates keys per frequency
  let chosenDateKeysByFreq = {
    diario: [initialBusinessKeys[0] || '2026-10-05'],
    flexible: initialBusinessKeys.slice(0, 3),
    semanal: initialBusinessKeys.slice(0, 5),
    mensual: initialBusinessKeys.slice(0, 5)
  };

  let activePlanDays = [];
  let planChoices = {};

  // DOM Elements
  const customerNameInput = document.getElementById('customer-name');
  const customerAddressInput = document.getElementById('customer-address');
  const mainPlanTitle = document.getElementById('main-plan-title');
  const planDescriptionBanner = document.getElementById('plan-description-banner');
  const optionSelectorWrapper = document.getElementById('option-selector-wrapper');
  
  const btnConfirmPlanConfig = document.getElementById('btn-confirm-plan-config');
  const btnConfirmPlanText = document.getElementById('btn-confirm-plan-text');
  const planConfigStatusText = document.getElementById('plan-config-status-text');
  const personalizationSectionWrapper = document.getElementById('personalization-section-wrapper');
  let isPlanConfigAccepted = false;

  const daysPickerTitle = document.getElementById('days-picker-title');
  const daysCountBadge = document.getElementById('days-count-badge');
  const daysHelperText = document.getElementById('days-helper-text');
  const calendarDaysGrid = document.getElementById('calendar-days-grid');
  const currentMonthName = document.getElementById('current-month-name');
  const btnPrevMonth = document.getElementById('btn-prev-month');
  const btnNextMonth = document.getElementById('btn-next-month');
  
  const daySelectionBadge = document.getElementById('day-selection-badge');
  const dayObservationInput = document.getElementById('day-observation-input');
  const btnSaveDay = document.getElementById('btn-save-day');
  const btnSaveDayText = document.getElementById('btn-save-day-text');
  const baseCarbDesc = document.getElementById('base-carb-desc');
  const baseVegDesc = document.getElementById('base-veg-desc');
  
  const sidebarPlanLabel = document.getElementById('sidebar-plan-label');
  const sidebarPriceDisplay = document.getElementById('sidebar-price-display');
  const sidebarSizeDesc = document.getElementById('sidebar-size-desc');
  const progressCounterBadge = document.getElementById('progress-counter-badge');
  const progressBarFill = document.getElementById('progress-bar-fill');
  const summaryDaysList = document.getElementById('summary-days-list');
  const daysSelectorContainer = document.getElementById('days-selector-container');
  
  const btnConfirmWhatsapp = document.getElementById('btn-confirm-whatsapp');
  const validationHelpText = document.getElementById('validation-help-text');
  const btnResetPlan = document.getElementById('btn-reset-plan');

  // Tabs
  const tabBtnPersonalizar = document.getElementById('tab-btn-personalizar');
  const tabBtnNutricion = document.getElementById('tab-btn-nutricion');
  const tabContentPersonalizar = document.getElementById('tab-content-personalizar');
  const tabContentNutricion = document.getElementById('tab-content-nutricion');

  tabBtnPersonalizar?.addEventListener('click', () => {
    tabBtnPersonalizar.className = "py-4 px-4 sm:px-6 text-[#8A6F56] border-b-2 border-[#B8935B] flex items-center gap-2 cursor-pointer transition-colors";
    tabBtnNutricion.className = "py-4 px-4 sm:px-6 text-gray-400 hover:text-gray-600 border-b-2 border-transparent flex items-center gap-2 cursor-pointer transition-colors";
    tabContentPersonalizar?.classList.remove('hidden');
    tabContentNutricion?.classList.add('hidden');
  });

  tabBtnNutricion?.addEventListener('click', () => {
    tabBtnNutricion.className = "py-4 px-4 sm:px-6 text-[#8A6F56] border-b-2 border-[#B8935B] flex items-center gap-2 cursor-pointer transition-colors";
    tabBtnPersonalizar.className = "py-4 px-4 sm:px-6 text-gray-400 hover:text-gray-600 border-b-2 border-transparent flex items-center gap-2 cursor-pointer transition-colors";
    tabContentPersonalizar?.classList.add('hidden');
    tabContentNutricion?.classList.remove('hidden');
  });

  const planPeriodDays = {
    diario: 14,
    flexible: 14,
    semanal: 14,
    mensual: 42
  };

  // Render Monthly Calendar Grid (Matching Reference UI & Strict Plan Period)
  function renderMonthlyCalendarGrid() {
    if (!calendarDaysGrid) return;
    calendarDaysGrid.innerHTML = '';

    const targetCount = planTargetBowls[selectedFreq] || 5;
    const currentChosen = chosenDateKeysByFreq[selectedFreq] || [];
    const maxPeriod = planPeriodDays[selectedFreq] || 14;

    if (daysPickerTitle) {
      if (selectedFreq === 'diario') daysPickerTitle.textContent = "Fecha de entrega (1 Bowl)";
      else if (selectedFreq === 'flexible') daysPickerTitle.textContent = "Fechas de entrega (3 Bowls)";
      else if (selectedFreq === 'semanal') daysPickerTitle.textContent = "Fechas de entrega (5 Bowls)";
      else if (selectedFreq === 'mensual') daysPickerTitle.textContent = "Fechas de entrega (Plan Mensual)";
    }

    if (daysCountBadge) {
      daysCountBadge.textContent = `${currentChosen.length} de ${targetCount} fechas seleccionadas`;
    }

    const planPeriodBadge = document.getElementById('plan-period-badge');
    if (planPeriodBadge) {
      if (currentChosen.length > 0) {
        const sorted = [...currentChosen].sort();
        const firstInfo = getDayInfoFromIso(sorted[0]);
        const firstDateObj = new Date(sorted[0] + 'T00:00:00');
        const maxLimitDateObj = new Date(firstDateObj.getTime() + (maxPeriod - 1) * 24 * 60 * 60 * 1000);
        const maxLimitD = String(maxLimitDateObj.getDate()).padStart(2, '0');
        const maxLimitM = String(maxLimitDateObj.getMonth() + 1).padStart(2, '0');
        const maxLimitY = maxLimitDateObj.getFullYear();
        const limitFormatted = `${maxLimitD}/${maxLimitM}/${maxLimitY}`;

        if (selectedFreq === 'diario') {
          planPeriodBadge.textContent = `Vigencia: 1 entrega (${firstInfo.dateStr})`;
        } else {
          planPeriodBadge.textContent = `Vigencia (máx. ${maxPeriod <= 14 ? '2 semanas' : '6 semanas'}): ${firstInfo.dateStr} al ${limitFormatted}`;
        }
      } else {
        if (selectedFreq === 'diario') {
          planPeriodBadge.textContent = `Vigencia: elige 1 fecha disponible`;
        } else {
          planPeriodBadge.textContent = `Vigencia del plan: hasta ${maxPeriod <= 14 ? '2 semanas' : '6 semanas'} desde tu primera fecha`;
        }
      }
    }

    if (daysHelperText) {
      if (currentChosen.length === targetCount) {
        daysHelperText.textContent = "Fechas completas. Puedes hacer clic en cualquier día para cambiarlo o desmarcarlo.";
      } else if (currentChosen.length === 0) {
        daysHelperText.textContent = "Haz clic en cualquier día hábil para establecer tu primera fecha de entrega.";
      } else {
        daysHelperText.textContent = `Selecciona ${targetCount - currentChosen.length} fecha(s) más dentro de tu periodo de vigencia.`;
      }
    }

    if (currentMonthName) {
      currentMonthName.textContent = `${fullMonthNames[currentViewMonth]} ${currentViewYear}`;
    }

    // Disable prev month button if current view month is today's month or before
    const today = new Date();
    const todayYear = today.getFullYear();
    const todayMonth = today.getMonth();
    const todayDate = today.getDate();
    const isPastCutoff = today.getHours() >= 15;

    if (btnPrevMonth) {
      const isCurrentOrPast = (currentViewYear < todayYear) || (currentViewYear === todayYear && currentViewMonth <= todayMonth);
      if (isCurrentOrPast) {
        btnPrevMonth.classList.add('opacity-30', 'pointer-events-none');
      } else {
        btnPrevMonth.classList.remove('opacity-30', 'pointer-events-none');
      }
    }

    // First day of current view month (0=Sun, 1=Mon, ..., 6=Sat)
    const firstDayOfWeek = new Date(currentViewYear, currentViewMonth, 1).getDay();
    const daysInCurrentMonth = new Date(currentViewYear, currentViewMonth + 1, 0).getDate();
    const daysInPrevMonth = new Date(currentViewYear, currentViewMonth, 0).getDate();

    // 1. Previous Month Leading Days (Disabled / Gray)
    for (let i = firstDayOfWeek - 1; i >= 0; i--) {
      const dayNum = daysInPrevMonth - i;
      const cell = document.createElement('div');
      cell.className = "py-1.5 flex items-center justify-center select-none";
      cell.innerHTML = `<span class="w-8 sm:w-9 h-9 sm:h-10 flex items-center justify-center text-gray-300 text-xs font-medium cursor-not-allowed opacity-40">${dayNum}</span>`;
      calendarDaysGrid.appendChild(cell);
    }

    // 2. Current Month Days
    for (let dayNum = 1; dayNum <= daysInCurrentMonth; dayNum++) {
      const cellDate = new Date(currentViewYear, currentViewMonth, dayNum);
      const dayOfWeek = cellDate.getDay(); // 0 = Sun, 6 = Sat
      const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);
      
      // Check if date is in past
      let isPast = false;
      if (currentViewYear < todayYear) isPast = true;
      else if (currentViewYear === todayYear) {
        if (currentViewMonth < todayMonth) isPast = true;
        else if (currentViewMonth === todayMonth) {
          if (dayNum < todayDate) isPast = true;
          else if (dayNum === todayDate && isPastCutoff) isPast = true;
        }
      }

      const mPad = String(currentViewMonth + 1).padStart(2, '0');
      const dPad = String(dayNum).padStart(2, '0');
      const isoKey = `${currentViewYear}-${mPad}-${dPad}`;
      const isSelected = currentChosen.includes(isoKey);

      // Check if candidate date is outside allowed plan period
      let isOutOfPeriod = false;
      if (currentChosen.length > 0) {
        const sorted = [...currentChosen].sort();
        const earliestDate = new Date(sorted[0] + 'T00:00:00');
        const latestDate = new Date(sorted[sorted.length - 1] + 'T00:00:00');

        if (!isSelected) {
          const newMin = Math.min(earliestDate.getTime(), cellDate.getTime());
          const newMax = Math.max(latestDate.getTime(), cellDate.getTime());
          const spanDays = Math.round((newMax - newMin) / (1000 * 60 * 60 * 24));
          if (spanDays >= maxPeriod) {
            isOutOfPeriod = true;
          }
        }
      }

      const cell = document.createElement('div');
      cell.className = "py-1 flex items-center justify-center";

      if (isWeekend || isPast || isOutOfPeriod) {
        const reasonTitle = isWeekend ? "Sin entregas en fin de semana" : (isPast ? "Fecha pasada" : `Fuera del periodo de vigencia del plan (máx. ${maxPeriod <= 14 ? '2 semanas' : '6 semanas'})`);
        cell.innerHTML = `<span class="w-8 sm:w-9 h-9 sm:h-10 flex items-center justify-center text-gray-300 text-xs sm:text-sm font-medium cursor-not-allowed select-none opacity-25" title="${reasonTitle}">${dayNum}</span>`;
      } else {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.isoKey = isoKey;

        if (isSelected) {
          // Selected date: Beige background with strong gold/bronze border and dark bold text
          btn.className = "w-8 sm:w-9 h-10 sm:h-11 mx-auto rounded-full bg-[#FAF6F0] hover:bg-[#F2E8DC] text-[#1e1912] font-black text-xs sm:text-sm flex flex-col items-center justify-center shadow-sm cursor-pointer transition-all duration-200 transform scale-105 border-2 border-[#B8935B]";
          btn.innerHTML = `<span class="leading-none">${dayNum}</span>`;
        } else {
          // Available unselected date: Clean white with subtle beige hover
          btn.className = "w-8 sm:w-9 h-10 sm:h-11 mx-auto rounded-full bg-white hover:bg-[#FAF6F0] text-gray-800 font-bold text-xs sm:text-sm border border-transparent hover:border-[#B8935B]/30 flex flex-col items-center justify-center cursor-pointer transition-all duration-150 shadow-2xs";
          btn.innerHTML = `<span class="leading-none">${dayNum}</span>`;
        }

        btn.addEventListener('click', () => {
          toggleDateSelection(isoKey);
        });

        cell.appendChild(btn);
      }

      calendarDaysGrid.appendChild(cell);
    }

    // 3. Next Month Trailing Days to complete 7-col grid row
    const totalRenderedCells = firstDayOfWeek + daysInCurrentMonth;
    const remainingInGrid = (7 - (totalRenderedCells % 7)) % 7;
    for (let i = 1; i <= remainingInGrid; i++) {
      const cell = document.createElement('div');
      cell.className = "py-1.5 flex items-center justify-center select-none";
      cell.innerHTML = `<span class="w-8 sm:w-9 h-9 sm:h-10 flex items-center justify-center text-gray-300 text-xs font-medium cursor-not-allowed opacity-40">${i}</span>`;
      calendarDaysGrid.appendChild(cell);
    }
  }

  function toggleDateSelection(isoKey) {
    const targetCount = planTargetBowls[selectedFreq] || 5;
    const currentChosen = chosenDateKeysByFreq[selectedFreq] || [];
    const maxPeriod = planPeriodDays[selectedFreq] || 14;

    // Special case for single-day plan (Plan Diario): directly switch to the clicked date
    if (targetCount === 1 || selectedFreq === 'diario') {
      chosenDateKeysByFreq[selectedFreq] = [isoKey];
      updatePlanConfiguration();
      return;
    }

    // Multi-day plans (Flexible, Semanal, Mensual)
    if (currentChosen.includes(isoKey)) {
      chosenDateKeysByFreq[selectedFreq] = currentChosen.filter(k => k !== isoKey);
      updatePlanConfiguration();
    } else {
      const candidateDate = new Date(isoKey + 'T00:00:00');
      if (currentChosen.length === 0) {
        chosenDateKeysByFreq[selectedFreq] = [isoKey];
        updatePlanConfiguration();
      } else if (currentChosen.length < targetCount) {
        const sorted = [...currentChosen].sort();
        const earliest = new Date(sorted[0] + 'T00:00:00');
        const latest = new Date(sorted[sorted.length - 1] + 'T00:00:00');
        const newMin = Math.min(earliest.getTime(), candidateDate.getTime());
        const newMax = Math.max(latest.getTime(), candidateDate.getTime());
        const spanDays = Math.round((newMax - newMin) / (1000 * 60 * 60 * 24));

        if (spanDays >= maxPeriod) {
          if (daysHelperText) {
            daysHelperText.textContent = `La fecha seleccionada sobrepasa el periodo de ${maxPeriod <= 14 ? '2 semanas' : '6 semanas'}. Desmarca fechas anteriores o haz clic en Reiniciar fechas.`;
          }
          return;
        }

        const newArr = [...currentChosen, isoKey];
        newArr.sort();
        chosenDateKeysByFreq[selectedFreq] = newArr;
        updatePlanConfiguration();
      } else {
        // Target count reached: seamlessly swap dates without alert
        const sorted = [...currentChosen].sort();
        const earliest = new Date(sorted[0] + 'T00:00:00');

        let remaining;
        if (candidateDate.getTime() < earliest.getTime()) {
          remaining = sorted.slice(0, targetCount - 1); // remove latest
        } else {
          remaining = sorted.slice(1); // remove earliest
        }

        const newMin = Math.min(...remaining.map(k => new Date(k + 'T00:00:00').getTime()), candidateDate.getTime());
        const newMax = Math.max(...remaining.map(k => new Date(k + 'T00:00:00').getTime()), candidateDate.getTime());
        const spanDays = Math.round((newMax - newMin) / (1000 * 60 * 60 * 24));

        if (spanDays < maxPeriod) {
          const newArr = [...remaining, isoKey];
          newArr.sort();
          chosenDateKeysByFreq[selectedFreq] = newArr;
          updatePlanConfiguration();
        } else {
          if (daysHelperText) {
            daysHelperText.textContent = `Desmarca una fecha o haz clic en "Reiniciar fechas" para cambiar tu rango de entrega.`;
          }
        }
      }
    }
  }

  // Reset dates button listener
  document.getElementById('btn-reset-dates')?.addEventListener('click', () => {
    chosenDateKeysByFreq[selectedFreq] = [];
    planChoices = {};
    isPlanConfigAccepted = false;
    personalizationSectionWrapper?.classList.add('hidden');
    updatePlanConfiguration();
  });

  // Month navigation buttons
  btnPrevMonth?.addEventListener('click', () => {
    currentViewMonth--;
    if (currentViewMonth < 0) {
      currentViewMonth = 11;
      currentViewYear--;
    }
    renderMonthlyCalendarGrid();
  });

  btnNextMonth?.addEventListener('click', () => {
    currentViewMonth++;
    if (currentViewMonth > 11) {
      currentViewMonth = 0;
      currentViewYear++;
    }
    renderMonthlyCalendarGrid();
  });

  // Confirm Plan Configuration CTA Listener
  btnConfirmPlanConfig?.addEventListener('click', () => {
    const targetCount = planTargetBowls[selectedFreq] || 5;
    const currentChosen = chosenDateKeysByFreq[selectedFreq] || [];

    if (currentChosen.length === targetCount) {
      isPlanConfigAccepted = true;
      if (personalizationSectionWrapper) {
        personalizationSectionWrapper.classList.remove('hidden');
        personalizationSectionWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      if (btnConfirmPlanText) {
        btnConfirmPlanText.textContent = `Configuración Aceptada ✓ (${targetCount} fechas)`;
      }
      if (planConfigStatusText) {
        planConfigStatusText.textContent = `Plan confirmado. Completa tu nombre y personaliza tus bowls abajo.`;
      }
      setTimeout(() => {
        if (customerNameInput && !customerNameInput.value.trim()) {
          customerNameInput.focus();
        }
      }, 400);
      updatePricingAndSummary();
    }
  });

  // Initialize and switch plan
  function updatePlanConfiguration() {
    const keys = chosenDateKeysByFreq[selectedFreq] || [];
    activePlanDays = keys.map((k, idx) => {
      const found = getDayInfoFromIso(k);
      return {
        ...found,
        num: `0${idx + 1}`
      };
    });
    
    // Ensure choice keys exist
    activePlanDays.forEach(d => {
      if (!planChoices[d.key]) {
        planChoices[d.key] = { bowlId: '', bowlName: '', protein: '', observation: '' };
      }
    });

    if (currentActiveDayIndex >= activePlanDays.length) {
      currentActiveDayIndex = 0;
    }

    // Hide/Show option selector (Grupal/Individual) for Diario
    if (optionSelectorWrapper) {
      if (selectedFreq === 'diario') {
        optionSelectorWrapper.classList.add('opacity-40', 'pointer-events-none');
      } else {
        optionSelectorWrapper.classList.remove('opacity-40', 'pointer-events-none');
      }
    }

    // Update Header texts
    if (mainPlanTitle) {
      mainPlanTitle.textContent = `Arma tus Bowls · ${planTitles[selectedFreq]}`;
    }
    if (planDescriptionBanner) {
      planDescriptionBanner.innerHTML = planDescriptions[selectedFreq];
    }

    // Update Confirm Plan Button State
    const targetCount = planTargetBowls[selectedFreq] || 5;
    const currentChosen = chosenDateKeysByFreq[selectedFreq] || [];

    if (btnConfirmPlanConfig && btnConfirmPlanText && planConfigStatusText) {
      if (currentChosen.length === targetCount) {
        btnConfirmPlanConfig.classList.remove('opacity-50', 'pointer-events-none');
        btnConfirmPlanConfig.classList.add('hover:-translate-y-0.5', 'active:scale-98', 'cursor-pointer');
        
        if (!isPlanConfigAccepted) {
          btnConfirmPlanText.textContent = `Aceptar y Personalizar Bowls (${targetCount} fechas)`;
          planConfigStatusText.textContent = `Fechas completas (${targetCount} de ${targetCount}). Haz clic en el botón para continuar.`;
        } else {
          btnConfirmPlanText.textContent = `Configuración Aceptada ✓ (${targetCount} fechas)`;
          planConfigStatusText.textContent = `Plan confirmado. Puedes seguir editando tus bowls abajo.`;
        }
      } else {
        const remaining = targetCount - currentChosen.length;
        btnConfirmPlanConfig.classList.add('opacity-50', 'pointer-events-none');
        btnConfirmPlanConfig.classList.remove('hover:-translate-y-0.5', 'active:scale-98');
        btnConfirmPlanText.textContent = `Selecciona ${remaining} fecha(s) más`;
        planConfigStatusText.textContent = `Faltan ${remaining} fecha(s) por elegir en el calendario para completar tu plan.`;

        // If dates become incomplete, hide personalization section again
        if (isPlanConfigAccepted) {
          isPlanConfigAccepted = false;
          personalizationSectionWrapper?.classList.add('hidden');
        }
      }
    }

    // Render Monthly Calendar Grid
    renderMonthlyCalendarGrid();

    // Render Day Selector Grid
    renderDaySelectors();

    // Render Sidebar list
    renderSidebarDays();

    // Update Pricing & texts
    updatePricingAndSummary();

    // Select active day
    if (activePlanDays.length > 0) {
      selectDay(currentActiveDayIndex);
    }
  }

  function renderDaySelectors() {
    if (!daysSelectorContainer) return;

    const count = activePlanDays.length;
    let gridColsClass = 'grid-cols-5';
    if (count === 1) gridColsClass = 'grid-cols-1 max-w-xs';
    else if (count === 2) gridColsClass = 'grid-cols-2 max-w-sm';
    else if (count === 3) gridColsClass = 'grid-cols-3 max-w-md';
    else if (count === 4) gridColsClass = 'grid-cols-4 max-w-lg';

    daysSelectorContainer.className = `grid ${gridColsClass} gap-2 sm:gap-3`;
    daysSelectorContainer.innerHTML = '';

    activePlanDays.forEach((day, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'day-tab-btn relative flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border border-gray-200 bg-white hover:border-[#B8935B] cursor-pointer transition-all duration-200';
      btn.dataset.dayKey = day.key;
      btn.dataset.dayIndex = idx.toString();
      btn.innerHTML = `
        <span class="day-number text-[10px] sm:text-[11px] font-extrabold text-gray-400 uppercase tracking-wider block">Día ${day.num}</span>
        <span class="day-short text-base sm:text-xl font-black text-gray-900 my-0.5 block leading-tight uppercase">${day.short}</span>
        <span class="day-status-text text-[10px] font-semibold text-gray-400 block">Elegir</span>
        <div class="day-saved-indicator hidden absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-[#B8935B] text-white flex items-center justify-center shadow-xs text-[10px] font-bold">✓</div>
      `;
      btn.addEventListener('click', () => selectDay(idx));
      daysSelectorContainer.appendChild(btn);
    });
  }

  function renderSidebarDays() {
    if (!summaryDaysList) return;
    summaryDaysList.innerHTML = '';

    activePlanDays.forEach((day, idx) => {
      const row = document.createElement('div');
      row.className = 'summary-day-row p-3 rounded-xl bg-white border border-gray-200/80 hover:border-[#B8935B] cursor-pointer transition-all flex items-center justify-between gap-3 group shadow-2xs';
      row.dataset.dayKey = day.key;
      row.dataset.dayIndex = idx.toString();
      row.innerHTML = `
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="w-7 h-7 rounded-lg bg-[#FAF6F0] text-gray-700 font-bold text-[11px] flex items-center justify-center shrink-0 group-hover:bg-[#B8935B] group-hover:text-white transition-colors">
            ${day.short}
          </span>
          <div class="min-w-0">
            <span class="text-xs font-bold text-gray-900 block truncate">${day.label}</span>
            <span class="text-[11px] text-gray-400 block truncate summary-day-desc" id="summary-desc-${day.key}">Por elegir</span>
            <span class="hidden text-[10px] text-[#8A6F56] font-medium truncate summary-obs-desc" id="summary-obs-${day.key}"></span>
          </div>
        </div>
        <span class="text-[11px] font-bold text-[#8A6F56] shrink-0 group-hover:underline">Editar</span>
      `;
      row.addEventListener('click', () => selectDay(idx));
      summaryDaysList.appendChild(row);
    });
  }

  function selectDay(index) {
    currentActiveDayIndex = index;
    const day = activePlanDays[index];
    if (!day) return;
    const key = day.key;
    const choice = planChoices[key] || { bowlId: '', bowlName: '', protein: '', observation: '' };

    if (daySelectionBadge) daySelectionBadge.textContent = `${day.label} seleccionado`;
    if (btnSaveDayText) btnSaveDayText.textContent = `Guardar elección del ${day.short}`;

    // Update Day Tab Buttons UI
    document.querySelectorAll('.day-tab-btn').forEach((btn, idx) => {
      const btnKey = btn.dataset.dayKey;
      const isSaved = planChoices[btnKey] && planChoices[btnKey].bowlId && planChoices[btnKey].protein;
      const indicator = btn.querySelector('.day-saved-indicator');

      if (indicator) {
        if (isSaved) indicator.classList.remove('hidden');
        else indicator.classList.add('hidden');
      }

      const shortEl = btn.querySelector('.day-short');
      const numEl = btn.querySelector('.day-number');
      const statusEl = btn.querySelector('.day-status-text');

      if (idx === index) {
        btn.className = "day-tab-btn relative flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border-2 border-[#B8935B] bg-[#FAF6F0] shadow-sm cursor-pointer transition-all duration-200 transform scale-102";
        if (numEl) numEl.className = "day-number text-[10px] sm:text-[11px] font-black text-[#8A6F56] uppercase tracking-wider block";
        if (shortEl) shortEl.className = "day-short text-base sm:text-xl font-black text-gray-950 my-0.5 block leading-tight uppercase";
        if (statusEl) {
          statusEl.className = "day-status-text text-[10px] font-bold text-[#B8935B] block";
          statusEl.textContent = isSaved ? "Listo ✓" : "Eligiendo";
        }
      } else {
        btn.className = "day-tab-btn relative flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border border-gray-200 bg-white hover:border-[#B8935B] cursor-pointer transition-all duration-200";
        if (numEl) numEl.className = "day-number text-[10px] sm:text-[11px] font-extrabold text-gray-400 uppercase tracking-wider block";
        if (shortEl) shortEl.className = "day-short text-base sm:text-xl font-black text-gray-800 my-0.5 block leading-tight uppercase";
        if (statusEl) {
          statusEl.className = "day-status-text text-[10px] font-semibold text-gray-400 block";
          statusEl.textContent = isSaved ? "Listo ✓" : "Elegir";
        }
      }
    });

    // Populate radio options and observation for this day
    document.querySelectorAll('.bowl-radio').forEach(r => {
      r.checked = (r.value === choice.bowlId);
    });
    document.querySelectorAll('.protein-radio').forEach(r => {
      r.checked = (r.value === choice.protein);
    });

    if (dayObservationInput) {
      dayObservationInput.value = choice.observation || '';
    }

    updateBowlCardsUI();
    updateProteinCardsUI();
    checkCurrentDayCompleteness();
    updatePricingAndSummary();
  }

  function updateBowlCardsUI() {
    document.querySelectorAll('.bowl-option-card').forEach(card => {
      const radio = card.querySelector('.bowl-radio');
      const circle = card.querySelector('.bowl-check-circle');
      const checkText = circle ? circle.querySelector('span') : null;

      if (radio && radio.checked) {
        card.classList.remove('border-gray-200', 'bg-white');
        card.classList.add('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        if (circle) {
          circle.classList.remove('border-gray-300');
          circle.classList.add('border-[#B8935B]', 'bg-[#B8935B]');
        }
        if (checkText) checkText.classList.remove('hidden');

        const bowlObj = availableBowls.find(b => b.id === radio.value);
        if (bowlObj) {
          if (baseCarbDesc) baseCarbDesc.textContent = bowlObj.carb;
          if (baseVegDesc) baseVegDesc.textContent = bowlObj.veg;
        }
      } else {
        card.classList.remove('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        card.classList.add('border-gray-200', 'bg-white');
        if (circle) {
          circle.classList.remove('border-[#B8935B]', 'bg-[#B8935B]');
          circle.classList.add('border-gray-300');
        }
        if (checkText) checkText.classList.add('hidden');
      }
    });
  }

  function updateProteinCardsUI() {
    document.querySelectorAll('.protein-option-card').forEach(card => {
      const radio = card.querySelector('.protein-radio');
      const circle = card.querySelector('.protein-check-circle');
      const checkText = circle ? circle.querySelector('span') : null;

      if (radio && radio.checked) {
        card.classList.remove('border-gray-200', 'bg-white');
        card.classList.add('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        if (circle) {
          circle.classList.remove('border-gray-300');
          circle.classList.add('border-[#B8935B]', 'bg-[#B8935B]');
        }
        if (checkText) checkText.classList.remove('hidden');
      } else {
        card.classList.remove('border-[#B8935B]', 'bg-[#FAF6F0]', 'shadow-xs');
        card.classList.add('border-gray-200', 'bg-white');
        if (circle) {
          circle.classList.remove('border-[#B8935B]', 'bg-[#B8935B]');
          circle.classList.add('border-gray-300');
        }
        if (checkText) checkText.classList.add('hidden');
      }
    });
  }

  function checkCurrentDayCompleteness() {
    const selectedBowlRadio = document.querySelector('.bowl-radio:checked');
    const selectedProteinRadio = document.querySelector('.protein-radio:checked');
    const day = activePlanDays[currentActiveDayIndex];
    if (!day) return;
    const dayKey = day.key;
    const observationText = dayObservationInput ? dayObservationInput.value.trim() : '';

    if (selectedBowlRadio && selectedProteinRadio) {
      const bowlObj = availableBowls.find(b => b.id === selectedBowlRadio.value);
      const bowlName = bowlObj ? bowlObj.name : selectedBowlRadio.value;
      
      planChoices[dayKey] = {
        bowlId: selectedBowlRadio.value,
        bowlName: bowlName,
        protein: selectedProteinRadio.value,
        observation: observationText
      };

      if (btnSaveDay) {
        btnSaveDay.classList.remove('opacity-50', 'pointer-events-none');
      }
    } else {
      if (btnSaveDay) {
        btnSaveDay.classList.add('opacity-50', 'pointer-events-none');
      }
    }
  }

  function updatePricingAndSummary() {
    const currentPrice = planPrices[selectedFreq][selectedSize][selectedOption];
    const sizeLabel = selectedSize === 'mediano' ? 'Mediano (~400g)' : 'Grande (~650g)';
    const freqLabel = planTitles[selectedFreq];
    const optionLabel = selectedFreq === 'diario' ? '' : (selectedOption === 'individual' ? 'Individual' : 'Grupal (3+ pers.)');

    if (sidebarPlanLabel) sidebarPlanLabel.textContent = `${freqLabel} ${optionLabel ? '• ' + optionLabel : ''}`;
    if (sidebarPriceDisplay) sidebarPriceDisplay.textContent = `Bs. ${currentPrice}`;
    if (sidebarSizeDesc) sidebarSizeDesc.textContent = `Tamaño ${sizeLabel}`;

    // Update items in sidebar list
    let completedCount = 0;
    const totalDays = activePlanDays.length;

    activePlanDays.forEach(day => {
      const choice = planChoices[day.key];
      const descEl = document.getElementById(`summary-desc-${day.key}`);
      const obsEl = document.getElementById(`summary-obs-${day.key}`);
      
      if (choice && choice.bowlId && choice.protein) {
        completedCount++;
        if (descEl) {
          descEl.textContent = `${choice.bowlName} • ${choice.protein}`;
          descEl.className = "text-[11px] font-bold text-[#8A6F56] block truncate summary-day-desc";
        }
        if (obsEl) {
          if (choice.observation) {
            obsEl.textContent = `Obs: ${choice.observation}`;
            obsEl.classList.remove('hidden');
          } else {
            obsEl.classList.add('hidden');
          }
        }
      } else {
        if (descEl) {
          descEl.textContent = "Por elegir";
          descEl.className = "text-[11px] text-gray-400 block truncate summary-day-desc";
        }
        if (obsEl) obsEl.classList.add('hidden');
      }
    });

    if (progressCounterBadge) progressCounterBadge.textContent = `${completedCount} de ${totalDays}`;
    if (progressBarFill) progressBarFill.style.width = `${totalDays > 0 ? (completedCount / totalDays) * 100 : 0}%`;

    const isAllCompleted = (totalDays > 0 && completedCount === totalDays);
    const customerName = customerNameInput ? customerNameInput.value.trim() : '';

    if (btnConfirmWhatsapp && validationHelpText) {
      if (isAllCompleted && customerName.length > 0) {
        btnConfirmWhatsapp.classList.remove('opacity-50', 'pointer-events-none', 'cursor-not-allowed');
        btnConfirmWhatsapp.classList.add('hover:-translate-y-0.5', 'active:scale-98');
        validationHelpText.textContent = "Menú completo. Haz clic para enviar tu pedido por WhatsApp.";
        validationHelpText.className = "text-[11px] text-center text-[#8A6F56] font-bold";

        const message = buildWhatsappMessage();
        const isMobileDev = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        const finalBase = isMobileDev ? baseWhatsappLink : baseWhatsappLink.replace('api.whatsapp.com/send', 'web.whatsapp.com/send');
        btnConfirmWhatsapp.href = `${finalBase}&text=${encodeURIComponent(message)}`;
      } else {
        btnConfirmWhatsapp.classList.add('opacity-50', 'pointer-events-none', 'cursor-not-allowed');
        btnConfirmWhatsapp.classList.remove('hover:-translate-y-0.5', 'active:scale-98');
        
        if (!customerName) {
          validationHelpText.textContent = "Por favor ingresa tu nombre arriba para continuar.";
          validationHelpText.className = "text-[11px] text-center text-amber-700 font-semibold";
        } else {
          const remaining = totalDays - completedCount;
          validationHelpText.textContent = `Completa los ${remaining} bowls pendientes para continuar.`;
          validationHelpText.className = "text-[11px] text-center text-gray-400 font-medium";
        }
      }
    }
  }

  function buildWhatsappMessage() {
    const customerName = customerNameInput ? customerNameInput.value.trim() : 'Cliente';
    const customerAddress = customerAddressInput ? customerAddressInput.value.trim() : '';
    const currentPrice = planPrices[selectedFreq][selectedSize][selectedOption];
    const sizeLabel = selectedSize === 'mediano' ? 'Mediano (~400g de balance)' : 'Grande (~650g de rendimiento)';
    const freqLabel = planTitles[selectedFreq];
    const optionLabel = selectedFreq === 'diario' ? '' : (selectedOption === 'individual' ? 'Individual (1 persona)' : 'Grupal (desde 3 personas)');

    const currentYear = new Date().getFullYear();
    if (!window._mcFolioNumber) {
      window._mcFolioNumber = Math.floor(1000 + Math.random() * 9000);
    }
    const orderFolioCode = `#MC-${currentYear}-${window._mcFolioNumber}`;

    // Generate Ultra-Compact URL for the Digital Sheet
    let comandaUrl = '';
    try {
      const proteinCodeMap = {
        "Pollo a la Plancha": "1",
        "Albóndigas de Carne (Air Fryer)": "2",
        "Huevos Hervidos": "3"
      };

      const planCode = activePlanDays.map(d => {
        const c = planChoices[d.key] || { bowlId: 'salteado', protein: 'Pollo a la Plancha' };
        const bCode = (c.bowlId === 'fresco') ? 'f' : 's';
        const pCode = proteinCodeMap[c.protein] || '1';
        return `${bCode}${pCode}`;
      }).join('-');

      const datesParam = activePlanDays.map(d => d.dateStr).join(',');
      const obsParam = activePlanDays.map(d => (planChoices[d.key]?.observation || '').replace(/\|/g, ' ')).join('|');

      const params = new URLSearchParams();
      params.set('c', customerName);
      if (customerAddress) params.set('dir', customerAddress);
      params.set('f', window._mcFolioNumber.toString());
      params.set('p', planCode);
      params.set('dt', datesParam);
      if (obsParam.replace(/\|/g, '').length > 0) {
        params.set('obs', obsParam);
      }
      params.set('sz', selectedSize);
      params.set('pl', selectedFreq);
      params.set('op', selectedOption);

      comandaUrl = `${window.location.origin}/comanda?${params.toString()}`;
    } catch(e) {
      comandaUrl = `${window.location.origin}/comanda`;
    }

    const firstDate = activePlanDays[0]?.dateStr || '';
    const lastDate = activePlanDays[activePlanDays.length - 1]?.dateStr || '';
    const dateRangeStr = (firstDate === lastDate) ? firstDate : `${firstDate} al ${lastDate}`;

    let msg = `*MONTALVO CATERING · FICHA & PEDIDO*\n`;
    msg += `*Folio:* ${orderFolioCode}\n`;
    msg += `----------------------------------------\n`;
    msg += `*Cliente:* ${customerName}\n`;
    if (customerAddress) {
      msg += `*Dirección:* ${customerAddress}\n`;
    }
    msg += `*Plan:* ${freqLabel}\n`;
    if (optionLabel) {
      msg += `*Modalidad:* ${optionLabel}\n`;
    }
    msg += `*Tamaño:* ${sizeLabel}\n`;
    msg += `*Vigencia / Fechas:* ${dateRangeStr}\n`;
    msg += `*Total a pagar:* Bs. ${currentPrice}\n`;
    if (comandaUrl) {
      msg += `\n*FICHA OFICIAL / COMANDA EN PDF:*\n${comandaUrl}\n`;
    }
    msg += `----------------------------------------\n`;
    msg += `*DETALLE DE ENTREGAS & MENÚ:*\n\n`;

    activePlanDays.forEach((day, idx) => {
      const choice = planChoices[day.key] || {};
      msg += `*ENTREGA ${idx + 1} (${day.dateStr}):*\n`;
      msg += `  • Bowl: ${choice.bowlName || 'Bowl Salteado'}\n`;
      msg += `  • Proteína: ${choice.protein || 'Pollo a la Plancha'}\n`;
      msg += `  • Observación: ${choice.observation || 'Estándar'}\n\n`;
    });

    msg += `----------------------------------------\n`;
    msg += `Montalvo Catering · Pedido Web`;

    return msg;
  }

  // Suggestion Tag Clicks
  document.querySelectorAll('.obs-tag-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const tag = e.currentTarget.dataset.tag;
      if (!dayObservationInput) return;
      const cur = dayObservationInput.value.trim();
      if (!cur) {
        dayObservationInput.value = tag;
      } else if (!cur.toLowerCase().includes(tag.toLowerCase())) {
        dayObservationInput.value = `${cur}, ${tag}`;
      }
      checkCurrentDayCompleteness();
      updatePricingAndSummary();
    });
  });

  // Observation Input Listener
  dayObservationInput?.addEventListener('input', () => {
    checkCurrentDayCompleteness();
    updatePricingAndSummary();
  });

  // Size Selector Click Listeners
  document.querySelectorAll('.size-selector-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      selectedSize = e.currentTarget.dataset.size;
      document.querySelectorAll('.size-selector-btn').forEach(b => {
        if (b.dataset.size === selectedSize) {
          b.className = "size-selector-btn py-2.5 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs";
        } else {
          b.className = "size-selector-btn py-2.5 px-3 rounded-xl text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all cursor-pointer";
        }
      });
      updatePricingAndSummary();
    });
  });

  // Freq Selector Click Listeners
  document.querySelectorAll('.freq-selector-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      selectedFreq = e.currentTarget.dataset.freq;
      document.querySelectorAll('.freq-selector-btn').forEach(b => {
        if (b.dataset.freq === selectedFreq) {
          b.className = "freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-extrabold text-center transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs";
        } else {
          b.className = "freq-selector-btn py-2.5 px-1.5 rounded-xl text-[11px] font-semibold text-gray-600 hover:text-gray-900 text-center transition-all cursor-pointer";
        }
      });
      updatePlanConfiguration();
    });
  });

  // Option Selector Click Listeners
  document.querySelectorAll('.option-selector-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      selectedOption = e.currentTarget.dataset.option;
      document.querySelectorAll('.option-selector-btn').forEach(b => {
        if (b.dataset.option === selectedOption) {
          b.className = "option-selector-btn py-2.5 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-[#B8935B] text-white shadow-xs";
        } else {
          b.className = "option-selector-btn py-2.5 px-3 rounded-xl text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all cursor-pointer";
        }
      });
      updatePricingAndSummary();
    });
  });

  // Bowl radio selection
  document.querySelectorAll('.bowl-radio').forEach(radio => {
    radio.addEventListener('change', () => {
      updateBowlCardsUI();
      checkCurrentDayCompleteness();
      updatePricingAndSummary();
    });
  });

  // Protein radio selection
  document.querySelectorAll('.protein-radio').forEach(radio => {
    radio.addEventListener('change', () => {
      updateProteinCardsUI();
      checkCurrentDayCompleteness();
      updatePricingAndSummary();
    });
  });

  btnSaveDay?.addEventListener('click', () => {
    checkCurrentDayCompleteness();
    updatePricingAndSummary();

    let nextIdx = -1;
    for (let i = 0; i < activePlanDays.length; i++) {
      const k = activePlanDays[i].key;
      if (!planChoices[k] || !planChoices[k].bowlId || !planChoices[k].protein) {
        nextIdx = i;
        break;
      }
    }

    if (nextIdx !== -1) {
      selectDay(nextIdx);
    } else {
      const next = (currentActiveDayIndex + 1) % activePlanDays.length;
      selectDay(next);
    }
  });

  customerNameInput?.addEventListener('input', () => {
    updatePricingAndSummary();
  });
  customerAddressInput?.addEventListener('input', () => {
    updatePricingAndSummary();
  });

  btnResetPlan?.addEventListener('click', () => {
    if (confirm('¿Estás seguro de reiniciar la selección de bowls?')) {
      planChoices = {};
      isPlanConfigAccepted = false;
      personalizationSectionWrapper?.classList.add('hidden');
      updatePlanConfiguration();
    }
  });

  // Init
  updatePlanConfiguration();
</script>
