---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ficha de Pedido & Comanda | Montalvo Catering">
  <div class="min-h-screen bg-gray-100 print:bg-white text-gray-900 py-6 sm:py-10 px-4 sm:px-6">
    
    <!-- Top Action Bar (Hidden during Print) -->
    <div class="max-w-3xl mx-auto mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-600 hover:text-brand-dark bg-white px-4 py-2.5 rounded-xl border border-gray-200 shadow-2xs transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Volver a la web</span>
      </a>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          onclick="window.print()" 
          class="inline-flex items-center gap-2 bg-[#B8935B] hover:bg-[#917237] text-white text-xs font-bold uppercase tracking-wider px-5 py-2.5 rounded-xl shadow-md transition-all cursor-pointer hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Descargar / Imprimir PDF</span>
        </button>
      </div>
    </div>

    <!-- Printable Official Sheet (A4 format feel) -->
    <div class="max-w-3xl mx-auto bg-white border border-gray-200 print:border-none shadow-lg print:shadow-none rounded-3xl print:rounded-none p-6 sm:p-10 text-gray-800 space-y-8 print:p-0">
      
      <!-- Sheet Header: Brand, Logo & Order Folio -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b-2 border-brand-gold/30">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-[#FAF6F0] border border-brand-gold flex flex-col items-center justify-center p-1 shadow-2xs shrink-0">
            <span class="font-cursive text-brand-dark text-lg leading-none">Montalvo</span>
            <div class="w-10 h-[0.5px] bg-brand-gold my-0.5"></div>
            <span class="font-sans text-[5px] tracking-[0.2em] text-brand-dark font-extrabold uppercase">Catering</span>
          </div>
          <div>
            <h1 class="font-serif font-black text-2xl text-gray-950 leading-tight">Montalvo Catering</h1>
            <span class="text-xs font-bold text-[#8A6F56] uppercase tracking-wider block">Alta Cocina Gourmet & Bowls Saludables</span>
            <span class="text-[11px] text-gray-500 block">Gral. Achá 739, Cochabamba, Bolivia • WhatsApp: +591 72227461</span>
          </div>
        </div>

        <div class="text-left sm:text-right bg-[#FAF6F0] sm:bg-transparent p-3 sm:p-0 rounded-2xl border sm:border-none border-brand-gold/15">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#8A6F56] block">Comanda / Ficha Técnica</span>
          <span id="order-folio" class="font-mono font-black text-base text-gray-900 block">FOLIO: #MC-2026-0000</span>
          <span id="order-date" class="text-xs text-gray-500 font-medium block">Fecha: --/--/----</span>
        </div>
      </div>

      <!-- Customer & Plan Information Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-[#FAF6F0] p-5 rounded-2xl border border-brand-gold/20 text-xs sm:text-sm">
        <div class="space-y-1.5">
          <div>
            <span class="text-gray-400 font-bold uppercase text-[10px] block">Cliente:</span>
            <strong id="client-name" class="text-base text-gray-950 font-black">Cargando...</strong>
          </div>
          <div>
            <span class="text-gray-400 font-bold uppercase text-[10px] block">Dirección de Entrega:</span>
            <span id="client-address" class="text-gray-700 font-medium">Por confirmar</span>
          </div>
        </div>

        <div class="space-y-1.5 sm:border-l sm:border-brand-gold/20 sm:pl-4">
          <div>
            <span class="text-gray-400 font-bold uppercase text-[10px] block">Tipo de Plan:</span>
            <strong id="client-plan" class="text-gray-900 font-bold">Plan Semanal (5 Bowls)</strong>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <span class="text-gray-400 font-bold uppercase text-[10px] block">Porción:</span>
              <span id="client-size" class="text-gray-700 font-medium">Mediano (~400g)</span>
            </div>
            <div class="text-right">
              <span class="text-gray-400 font-bold uppercase text-[10px] block">Total:</span>
              <strong id="client-total" class="text-base font-black text-emerald-800">Bs. 110</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Production Table (Exact format matching user specification) -->
      <div class="space-y-4">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-gray-900">
            La orden para producción de cocina & despacho:
          </h2>
        </div>

        <div class="overflow-x-auto border-y border-gray-200">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-gray-200 text-gray-900 font-bold text-xs sm:text-sm bg-gray-50/50">
                <th class="py-4 px-3 sm:px-4 font-bold whitespace-nowrap">Fecha de<br class="hidden sm:inline"> entrega</th>
                <th class="py-4 px-3 sm:px-4 font-bold">Cliente</th>
                <th class="py-4 px-3 sm:px-4 font-bold">Bol</th>
                <th class="py-4 px-3 sm:px-4 font-bold">Proteína</th>
                <th class="py-4 px-3 sm:px-4 font-bold">Tamaño</th>
                <th class="py-4 px-3 sm:px-4 font-bold">Observaciones</th>
                <th class="py-4 px-3 sm:px-4 font-bold text-center">Cantidad</th>
              </tr>
            </thead>
            <tbody id="production-tbody" class="divide-y divide-gray-100 text-gray-800 font-medium">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Kitchen Production Notes & Quality Signature -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-gray-100 text-xs text-gray-500">
        <div class="space-y-1 bg-gray-50 p-4 rounded-xl border border-gray-100">
          <strong class="text-gray-800 font-bold block uppercase text-[10px] tracking-wider">Instrucciones para Cocina & Despacho:</strong>
          <p class="leading-relaxed">
            • Mantener cadena de frío para el Bowl Fresco.<br>
            • Servir el Bowl Salteado con vegetales crujientes al wok en punto al dente.<br>
            • Respetar estrictamente las observaciones nutricionales y alergias indicadas por el cliente.<br>
            • Verificar el empaque sellado hermético antes de la entrega.
          </p>
        </div>

        <div class="flex flex-col justify-end items-center sm:items-end p-4 text-center sm:text-right">
          <div class="w-48 border-b border-gray-300 pb-1 mb-1"></div>
          <span class="font-bold text-gray-800 text-[11px]">Responsable de Producción</span>
          <span class="text-[10px] text-gray-400">Montalvo Catering Gourmet</span>
        </div>
      </div>

      <!-- Sheet Footer -->
      <div class="pt-4 border-t border-gray-200 text-center text-[10px] text-gray-400 flex flex-col sm:flex-row items-center justify-between gap-2">
        <span>© Montalvo Catering • Cochabamba, Bolivia</span>
        <span class="font-mono">Documento digital generado automáticamente desde la web</span>
      </div>

    </div>

  </div>
</Layout>

<style>
  @media print {
    @page {
      margin: 1.5cm;
      size: A4 portrait;
    }
    body {
      background: white !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }
</style>

<script is:inline>
  const proteinDecodeMap = {
    "1": "Pollo a la Plancha",
    "2": "Albóndigas de Carne (Air Fryer)",
    "3": "Huevos Hervidos"
  };

  function decodeCompactPlan(pString, datesCount, obsList) {
    const choices = [];
    const cleaned = (pString || '').replace(/[^a-zA-Z0-9]/g, '');
    const count = datesCount > 0 ? datesCount : 5;

    for (let i = 0; i < count; i++) {
      const bChar = cleaned[i * 2] || 's';
      const pChar = cleaned[i * 2 + 1] || '1';

      const bowlId = (bChar === 'f') ? 'fresco' : 'salteado';
      const bowlName = (bowlId === 'fresco') ? 'Bowl Fresco' : 'Bowl Salteado';
      const protein = proteinDecodeMap[pChar] || 'Pollo a la Plancha';
      const observation = (obsList && obsList[i]) ? obsList[i].trim() : '';

      choices.push({
        bowlId,
        bowlName,
        protein,
        observation
      });
    }
    return choices;
  }

  const planPrices = {
    diario: {
      mediano: { individual: 24, grupal: 24 },
      grande: { individual: 37, grupal: 37 }
    },
    flexible: {
      mediano: { individual: 69, grupal: 207 },
      grande: { individual: 108, grupal: 324 }
    },
    semanal: {
      mediano: { individual: 110, grupal: 330 },
      grande: { individual: 175, grupal: 525 }
    },
    mensual: {
      mediano: { individual: 400, grupal: 1200 },
      grande: { individual: 660, grupal: 1980 }
    }
  };

  const planTitles = {
    diario: 'Plan Diario (1 Bowl)',
    flexible: 'Plan Flexible (3 Bowls)',
    semanal: 'Plan Semanal (5 Bowls)',
    mensual: 'Plan Mensual (20 Bowls)'
  };

  function parseOrderData() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const rawData = urlParams.get('data');
      const compactCode = urlParams.get('p');
      const datesQuery = urlParams.get('dt');
      const obsQuery = urlParams.get('obs');
      const daysQuery = urlParams.get('d');
      const clientQuery = urlParams.get('c');
      const dirQuery = urlParams.get('dir');
      const folioQuery = urlParams.get('f') || urlParams.get('folio');
      const szQuery = urlParams.get('sz') || 'mediano';
      const plQuery = urlParams.get('pl') || 'semanal';
      const opQuery = urlParams.get('op') || 'individual';

      let order = null;

      const calcPrice = (planPrices[plQuery] && planPrices[plQuery][szQuery] && planPrices[plQuery][szQuery][opQuery]) || 110;
      const sizeStr = (szQuery === 'grande') ? 'Grande (~650g de rendimiento)' : 'Mediano (~400g de balance)';
      const sizeShort = (szQuery === 'grande') ? 'Grande' : 'Mediano';
      const planStr = planTitles[plQuery] || 'Plan Semanal (5 Bowls)';
      const modalStr = (plQuery === 'diario') ? '' : (opQuery === 'grupal' ? ' • Grupal (3+ pers.)' : ' • Individual');

      const parsedDatesList = datesQuery ? datesQuery.split(',').filter(Boolean) : (daysQuery ? daysQuery.split(',').filter(Boolean) : null);
      const parsedObsList = obsQuery ? obsQuery.split('|') : [];

      if (compactCode || clientQuery) {
        // Compact Short URL Format
        const decodedItems = decodeCompactPlan(compactCode || 's1s1s1s1s1', parsedDatesList ? parsedDatesList.length : 5, parsedObsList);
        
        order = {
          folio: folioQuery ? `#MC-${new Date().getFullYear()}-${folioQuery}` : null,
          name: clientQuery || 'Cliente Particular',
          address: dirQuery || 'Por coordinar por WhatsApp',
          plan: `${planStr}${modalStr}`,
          size: sizeStr,
          sizeShort: sizeShort,
          datesList: parsedDatesList,
          total: calcPrice.toString(),
          date: new Date().toLocaleDateString('es-BO'),
          items: decodedItems
        };
      } else if (rawData) {
        // Legacy Base64 Format
        const decodedStr = decodeURIComponent(escape(atob(decodeURIComponent(rawData))));
        const parsed = JSON.parse(decodedStr);
        order = {
          ...parsed,
          items: Object.keys(parsed.choices || {}).map(k => parsed.choices[k]),
          datesList: null,
          sizeShort: (parsed.size && parsed.size.includes('Grande')) ? 'Grande' : 'Mediano'
        };
      } else {
        // Fallback to local storage
        const local = localStorage.getItem('montalvo_weekly_plan_v2');
        if (local) {
          const parsed = JSON.parse(local);
          order = {
            name: parsed.name || 'Cliente Particular',
            address: parsed.address || 'A convenir por WhatsApp',
            plan: 'Plan Semanal (5 Bowls)',
            size: 'Mediano (~400g de balance)',
            sizeShort: 'Mediano',
            datesList: null,
            total: '110',
            date: new Date().toLocaleDateString('es-BO'),
            items: Object.keys(parsed.weeklyChoices || {}).map(k => parsed.weeklyChoices[k])
          };
        }
      }

      renderOrderSheet(order);
    } catch (e) {
      console.error("Error parsing order", e);
      renderFallback();
    }
  }

  function getFallbackDates() {
    const today = new Date();
    const dates = [];
    let cur = new Date(today);
    while (dates.length < 5) {
      const dow = cur.getDay();
      if (dow >= 1 && dow <= 5) {
        const dd = String(cur.getDate()).padStart(2, '0');
        const mm = String(cur.getMonth() + 1).padStart(2, '0');
        const yyyy = cur.getFullYear();
        dates.push(`${dd}/${mm}/${yyyy}`);
      }
      cur.setDate(cur.getDate() + 1);
    }
    return dates;
  }

  function renderOrderSheet(order) {
    if (!order) {
      renderFallback();
      return;
    }

    const hash = Math.floor(1000 + Math.random() * 9000);
    const folio = order.folio || `#MC-${new Date().getFullYear()}-${hash}`;

    const orderFolio = document.getElementById('order-folio');
    const orderDate = document.getElementById('order-date');
    const clientName = document.getElementById('client-name');
    const clientAddress = document.getElementById('client-address');
    const clientPlan = document.getElementById('client-plan');
    const clientSize = document.getElementById('client-size');
    const clientTotal = document.getElementById('client-total');
    const tbody = document.getElementById('production-tbody');

    if (orderFolio) orderFolio.textContent = folio;
    if (orderDate) orderDate.textContent = `Fecha: ${order.date || new Date().toLocaleDateString('es-BO')}`;
    if (clientName) clientName.textContent = order.name || 'Cliente';
    if (clientAddress) clientAddress.textContent = order.address || 'Entrega coordinada por WhatsApp';
    if (clientPlan) clientPlan.textContent = order.plan || 'Plan Semanal (5 Bowls)';
    if (clientSize) clientSize.textContent = order.size || 'Mediano (~400g de balance)';
    if (clientTotal) clientTotal.textContent = `Bs. ${order.total || '110'}`;

    if (tbody && order.items) {
      tbody.innerHTML = '';
      const fallbackDates = getFallbackDates();
      const sizeText = order.sizeShort || 'Mediano';
      const clientStr = order.name || 'Cliente';

      order.items.forEach((item, idx) => {
        const bowlType = (item.bowlId === 'fresco' || (item.bowlName && item.bowlName.includes('Fresco'))) ? 'Bowl Fresco' : 'Bowl Salteado';
        const proteinName = item.protein || 'Pollo a la Plancha';
        const dateStr = (order.datesList && order.datesList[idx]) ? order.datesList[idx] : (fallbackDates[idx] || 'Próximo día');
        const observationText = item.observation ? item.observation.trim() : '';

        const tr = document.createElement('tr');
        tr.className = "hover:bg-gray-50/80 transition-colors";
        tr.innerHTML = `
          <td class="py-4 px-3 sm:px-4 font-mono text-xs sm:text-sm text-gray-950 font-bold whitespace-nowrap">
            ${dateStr}
          </td>
          <td class="py-4 px-3 sm:px-4 text-gray-900 font-medium">
            ${clientStr}
          </td>
          <td class="py-4 px-3 sm:px-4 font-bold text-gray-950">
            ${bowlType}
          </td>
          <td class="py-4 px-3 sm:px-4 text-gray-800 font-medium">
            ${proteinName}
          </td>
          <td class="py-4 px-3 sm:px-4 text-gray-600 font-medium">
            ${sizeText}
          </td>
          <td class="py-4 px-3 sm:px-4">
            ${observationText ? `<span class="inline-block px-2.5 py-1 bg-amber-50 text-amber-900 border border-amber-200/80 rounded-lg text-xs font-semibold">${observationText}</span>` : `<span class="text-gray-400 italic text-xs">Estándar</span>`}
          </td>
          <td class="py-4 px-3 sm:px-4 text-center font-bold text-gray-950">
            1
          </td>
        `;
        tbody.appendChild(tr);
      });
    }
  }

  function renderFallback() {
    const clientName = document.getElementById('client-name');
    if (clientName) clientName.textContent = "No se encontraron datos del pedido";
  }

  // Run on page load
  parseOrderData();
</script>
